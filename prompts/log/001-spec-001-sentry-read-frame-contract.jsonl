\n40\telse\n41\t  issue_id=\"$(printf '%s' \"$issue_id\" | sed -nE 's#.*/issues/([0-9]+)/?.*#\\1#p')\"\n42\t  if [ -z \"$issue_id\" ]; then\n43\t    echo \"could not extract a numeric Sentry issue id from: $1\" >&2\n44\t    exit 2\n45\t  fi\n46\tfi\n47\t\n48\tresponse=\"$(curl -fsS --max-time 30 \\\n49\t  -H \"Authorization: Bearer ${SENTRY_API_TOKEN}\" \\\n50\t  \"${SENTRY_URL}/api/0/organizations/${SENTRY_ORG}/issues/${issue_id}/\")\"\n51\t\n52\t# Emit the fields the verdict rubric consumes, in a stable order.\n53\tprintf 'short_id=%s\\n'    \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"shortId\"])')\"\n54\tprintf 'status=%s\\n'      \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"status\"])')\"\n55\tprintf 'live_event_count=%s\\n' \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"count\"])')\"\n56\tprintf 'first_seen=%s\\n'  \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"firstSeen\"])')\"\n57\tprintf 'last_seen=%s\\n'   \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"lastSeen\"])')\"\n58\tprintf 'users_impacted=%s\\n' \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"userCount\"])')\"\n59\tprintf 'title=%s\\n'       \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"title\"])')\"\n60\t\n61\t# Best-effort fetch of the latest event's stack trace. A failure here must not\n62\t# fail the run (metadata is the deliverable), so the fetch is guarded and its\n63\t# outcome classified into exactly one stack_trace unavailable (<reason>) line.\n64\tevent_body=\"$(mktemp)\"\n65\ttrap 'rm -f \"${event_body}\"' EXIT\n66\t\n67\tset +e\n68\tevent_http=\"$(curl -sS --max-time 30 -o \"${event_body}\" -w '%{http_code}' \\\n69\t  -H \"Authorization: Bearer ${SENTRY_API_TOKEN}\" \\\n70\t  \"${SENTRY_