{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-80f2d4b2735765db","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\t// Package prompts provides embedded per-phase prompt fragments for the\n6\t// Sentry analyzer agent. Each active phase (planning, execution) gets its\n7\t// own domain module; output-format.md is the shared JSON output contract.\n8\tpackage prompts\n9\t\n10\timport (\n11\t\t_ \"embed\"\n12\t\n13\t\tclaudelib \"github.com/bborbe/agent/claude\"\n14\t)\n15\t\n16\t//go:embed planning.md\n17\tvar planning string\n18\t\n19\t//go:embed execution.md\n20\tvar execution string\n21\t\n22\t//go:embed deep-planning.md\n23\tvar deepPlanning string\n24\t\n25\t//go:embed deep-execution.md\n26\tvar deepExecution string\n27\t\n28\t//go:embed collector-planning.md\n29\tvar collectorPlanning string\n30\t\n31\t//go:embed output-format.md\n32\tvar outputFormat string\n33\t\n34\t// BuildPlanningInstructions assembles the triage planning-phase prompt: the\n35\t// domain planning module plus the shared output-format contract. Used by the\n36\t// sentry-issue-analyzer task type (the daily-batch triage agent).\n37\tfunc BuildPlanningInstructions() claudelib.Instructions {\n38\t\treturn claudelib.Instructions{\n39\t\t\t{Name: \"planning\", Content: planning},\n40\t\t\t{Name: \"output-format\", Content: outputFormat},\n41\t\t}\n42\t}\n43\t\n44\t// BuildExecutionInstructions assembles the triage execution-phase prompt: the\n45\t// 6-verdict rubric + noise disqualifiers, plus the shared output-format\n46\t// contract. Used by the sentry-issue-analyzer task type.\n47\tfunc BuildExecutionInstructions() claudelib.Instructions {\n48\t\treturn claudelib.Instructions{\n49\t\t\t{Name: \"execution\", Content: execution},\n50\t\t\t{Name: \"output-format\", Content: outputFormat},\n51\t\t}\n52\t}\n53\t\n54\t// BuildCollectorPlanningInstructions assembles the collector planning-phase prompt:\n55\t// the collector module (fetch day's alerts + create per-alert tasks) plus the\n56\t// shared output-format contract. Used by the sentry-collector task type (the\n57\t// daily-batch producer step that emits per-alert tasks for the triage agent).\n58\tfunc BuildCollectorPlanningInstructions() claudelib.Instructions {\n59\t\treturn claudelib.Instructions{\n60\t\t\t{Name: \"collector-planning\", Content: collectorPlanning},\n61\t\t\t{Name: \"output-format\", Content: outputFormat},\n62\t\t}\n63\t}\n64\t\n65\t// BuildDeepPlanningInstructions assembles the deep planning-phase prompt: the\n66\t// deep root-cause module (LIVE state + read-only clone) plus the shared\n67\t// output-format contract. Used by the sentry-deep-analyzer task type.\n68\tfunc BuildDeepPlanningInstructions() claudelib.Instructions {\n69\t\treturn claudelib.Instructions{\n70\t\t\t{Name: \"deep-planning\", Content: deepPlanning},\n71\t\t\t{Name: \"output-format\", Content: outputFormat},\n72\t\t}\n73\t}\n74\t\n75\t// BuildDeepExecutionInstructions assembles the deep execution-phase prompt:\n76\t// the octopus verdict schema (U/F + file:line + disqualifiers_fired) plus the\n77\t// shared output-format contract. Used by the sentry-deep-analyzer task type.\n78\tfunc BuildDeepExecutionInstructions() claudelib.Instructions {\n79\t\treturn claudelib.Instructions{\n80\t\t\t{Name: \"deep-execution\", Content: deepExecution},\n81\t\t\t{Name: \"output-format\", Content: outputFormat},\n82\t\t}\n83\t}\n84\t"}]},"parent_tool_use_id":null,"session_id":"d3fd6381-20a0-472d-ab49-d042f043db0e","uuid":"c7acec70-7644-4498-988d-0caaa4eb8790","timestamp":"2026-09-01T12:55:11.586Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/prompts/prompts.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\n// Package prompts provides embedded per-phase prompt fragments for the\n// Sentry analyzer agent. Each active phase (planning, execution) gets its\n// own domain module; output-format.md is the shared JSON output contract.\npackage prompts\n\nimport (\n\t_ \"embed\"\n\n\tclaudelib \"github.com/bborbe/agent/claude\"\n)\n\n//go:embed planning.md\nvar planning string\n\n//go:embed execution.md\nvar execution string\n\n//go:embed deep-planning.md\nvar deepPlanning string\n\n//go:embed deep-execution.md\nvar deepExecution string\n\n//go:embed collector-planning.md\nvar collectorPlanning string\n\n//go:embed output-format.md\nvar outputFormat string\n\n// BuildPlanningInstructions assembles the triage planning-phase prompt: the\n// domain planning module plus the shared output-format contract. Used by the\n// sentry-issue-analyzer task type (the daily-batch triage agent).\nfunc BuildPlanningInstructions() claudelib.Instructions {\n\treturn claudelib.Instructions{\n\t\t{Name: \"planning\", Content: planning},\n\t\t{Name: \"output-format\", Content: outputFormat},\n\t}\n}\n\n// BuildExecutionInstructions assembles the triage execution-phase prompt: the\n// 6-verdict rubric + noise disqualifiers, plus the shared output-format\n// contract. Used by the sentry-issue-analyzer task type.\nfunc BuildExecutionInstructions() claudelib.Instructions {\n\treturn claudelib.Instructions{\n\t\t{Name: \"execution\", Content: execution},\n\t\t{Name: \"output-format\", Content: outputFormat},\n\t}\n}\n\n// BuildCollectorPlanningInstructions assembles the collector planning-phase prompt:\n// the collector module (fetch day's alerts + create per-alert tasks) plus the\n// shared output-format contract. Used by the sentry-collector task type (the\n// daily-batch producer step that emits per-alert tasks for the triage agent).\nfunc BuildCollectorPlanningInstructions() claudelib.Instructions {\n\treturn claudelib.Instructions{\n\t\t{Name: \"collector-planning\", Content: collectorPlanning},\n\t\t{Name: \"output-format\", Content: outputFormat},\n\t}\n}\n\n// BuildDeepPlanningInstructions assembles the deep planning-phase prompt: the\n// deep root-cause module (LIVE state + read-only clone) plus the shared\n// output-format contract. Used by the sentry-deep-analyzer task type.\nfunc BuildDeepPlanningInstructions() claudelib.Instructions {\n\treturn claudelib.Instructions{\n\t\t{Name: \"deep-planning\", Content: deepPlanning},\n\t\t{Name: \"output-format\", Content: outputFormat},\n\t}\n}\n\n// BuildDeepExecutionInstructions assembles the deep execution-phase prompt:\n// the octopus verdict schema (U/F + file:line + disqualifiers_fired) plus the\n// shared output-format contract. Used by the sentry-deep-analyzer task type.\nfunc BuildDeepExecutionInstructions() claudelib.Instructions {\n\treturn claudelib.Instructions{\n\t\t{Name: \"deep-execution\", Content: deepExecution},\n\t\t{Name: \"output-format\", Content: outputFormat},\n\t}\n}\n","numLines":84,"startLine":1,"totalLines":84}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-bd893dcd28120127","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage prompts_test\n6\t\n7\timport (\n8\t\t. \"github.com/onsi/ginkgo/v2\"\n9\t\t. \"github.com/onsi/gomega\"\n10\t\n11\t\t\"github.com/bborbe/agent-sentry-issue-analyzer/pkg/prompts\"\n12\t)\n13\t\n14\tvar _ = Describe(\"BuildPlanningInstructions (triage)\", func() {\n15\t\tIt(\"returns exactly 2 instructions\", func() {\n16\t\t\tinstrs := prompts.BuildPlanningInstructions()\n17\t\t\tExpect(instrs).To(HaveLen(2))\n18\t\t})\n19\t\n20\t\tIt(\"first instruction is planning\", func() {\n21\t\t\tinstrs := prompts.BuildPlanningInstructions()\n22\t\t\tExpect(instrs[0].Name).To(Equal(\"planning\"))\n23\t\t\tExpect(instrs[0].Content).NotTo(BeEmpty())\n24\t\t})\n25\t\n26\t\tIt(\"second instruction is output-format\", func() {\n27\t\t\tinstrs := prompts.BuildPlanningInstructions()\n28\t\t\tExpect(instrs[1].Name).To(Equal(\"output-format\"))\n29\t\t\tExpect(instrs[1].Content).NotTo(BeEmpty())\n30\t\t})\n31\t\n32\t\tIt(\"planning prompt contains the token-REST live-state script invocation\", func() {\n33\t\t\tinstrs := prompts.BuildPlanningInstructions()\n34\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/sentry-read.sh\"))\n35\t\t})\n36\t\n37\t\tIt(\"planning prompt contains the read-only repo clone invocation\", func() {\n38\t\t\tinstrs := prompts.BuildPlanningInstructions()\n39\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/repo-clone.sh clone\"))\n40\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/repo-clone.sh log\"))\n41\t\t})\n42\t\n43\t\tIt(\"planning prompt contains the ## Analysis section heading\", func() {\n44\t\t\tinstrs := prompts.BuildPlanningInstructions()\n45\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"#