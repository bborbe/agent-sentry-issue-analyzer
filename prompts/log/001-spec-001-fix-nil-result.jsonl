{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9690d46c131d7104","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\t// Command agent-sentry-issue-analyzer is the canonical AI-heavy agent: one Claude\n6\t// invocation per phase, all logic in the prompt + allowed tools.\n7\t//\n8\t// This binary is the Kafka entry point — spawned as a K8s Job by\n9\t// task/executor with TASK_CONTENT + TASK_ID + PHASE + KAFKA_BROKERS env.\n10\t// For local CLI mode (file-based), see cmd/run-task/main.go.\n11\t//\n12\t// Reference implementation for AI-heavy agents using the agent framework\n13\t// (lib.NewAgent + claude.NewAgentStep). Other agents (trade-analysis,\n14\t// pr-reviewer) follow the same shape — copy this main.go and swap\n15\t// prompts/tools.\n16\tpackage main\n17\t\n18\timport (\n19\t\t\"context\"\n20\t\t\"os\"\n21\t\t\"time\"\n22\t\n23\t\tagentlib \"github.com/bborbe/agent\"\n24\t\tclaudelib \"github.com/bborbe/agent/claude\"\n25\t\tdelivery \"github.com/bborbe/agent/delivery\"\n26\t\t\"github.com/bborbe/agent/envparse\"\n27\t\tlibmetrics \"github.com/bborbe/agent/metrics\"\n28\t\t\"github.com/bborbe/cqrs/base\"\n29\t\t\"github.com/bborbe/errors\"\n30\t\tlibkafka \"github.com/bborbe/kafka\"\n31\t\t\"github.com/bborbe/maintainer/githubapp\"\n32\t\tlibsentry \"github.com/bborbe/sentry\"\n33\t\t\"github.com/bborbe/service\"\n34\t\tlibtime \"github.com/bborbe/time\"\n35\t\t\"github.com/bborbe/vault-cli/pkg/domain\"\n36\t\t\"github.com/golang/glog\"\n37\t\t\"github.com/prometheus/client_golang/prometheus\"\n38\t\t\"github.com/prometheus/client_golang/prometheus/push\"\n39\t\n40\t\t\"github.com/bborbe/agent-sentry-issue-analyzer/pkg/factory\"\n41\t\t\"github.com/bborbe/agent-sentry-issue-analyzer/pkg/preflight\"\n42\t)\n43\t\n44\t// agentName is the identity string used for Prometheus metric grouping and logging.\n45\tconst agentName = \"claude-agent\"\n46\t\n47\t// taskTypeSentryCollector is the collector step's task-type literal (mirrors\n48\t// factory.taskTypeSentryCollector). The collector has a single planning phase and\n49\t// a different tool contract (scripts/sentry-create-tasks.sh instead of\n50\t// sentry-read.sh / repo-clone.sh), so it gets its own preflight.\n51\tconst taskTypeSentryCollector = \"sentry-collector\"\n52\t\n53\tfunc main() {\n54\t\tapp := &application{}\n55\t\tos.Exit(service.Main(context.Background(), app, &app.SentryDSN, &app.SentryProxy))\n56\t}\n57\t\n58\ttype application struct {\n59\t\tSentryDSN      string `required:\"false\" arg:\"sentry-dsn\"       env:\"SENTRY_DSN\"       usage:\"SentryDSN\"                                        display:\"length\"`\n60\t\tSentryProxy    string `required:\"false\" arg:\"sentry-proxy\"     env:\"SENTRY_PROXY\"     usage:\"Sentry Proxy\"                                     display:\"length\"`\n61\t\tSentryAPIToken string `required:\"true\"  arg:\"sentry-api-token\" env:\"SENTRY_API_TOKEN\" usage:\"Sentry REST API Bearer token (teamvault-sourced)\" display:\"length\"`\n62\t\n63\t\t// GitHub App auth for read-only cloning of private repos (repo-clone.sh).\n64\t\t// The pod mints an installation access token at startup (same pattern as\n65\t\t// github-pr-review-agent resolveAuth) and exposes it to the Claude\n66\t\t// subprocess as GIT_CLONE_TOKEN so repo-clone.sh can clone private\n67\t\t// bborbe/seibert repos. APP_ID + INSTALLATION_ID + one of PEM/PEM_KEY are\n68\t\t// required for App auth.\n69\t\tAppID          int64  `required:\"false\" arg:\"app-id\"          env:\"APP_ID\"          usage:\"GitHub App ID (numeric); required for App auth\"`\n70\t\tInstallationID int64  `required:\"false\" arg:\"installation-id\" env:\"INSTALLATION_ID\" usage:\"GitHub App installation ID; required for App auth\"`\n71\t\tPEMKey         string `required:\"false\" arg:\"pem-key\"         env:\"PEM_KEY\"         usage:\"GitHub App private key (PEM) as env var content\"   display:\"length\"`\n72\t\n73\t\t// Claude Code CLI configuration\n74\t\tClaudeConfigDir claudelib.ClaudeConfigDir `required:\"false\" arg:\"claude-config-dir\" env:\"CLAUDE_CONFIG_DIR\" usage:\"Claude Code config directory\"`\n75\t\n76\t\t// Agent directory (contains .claude/ with CLAUDE.md and commands)\n77\t\tAgentDir claudelib.AgentDir `required:\"false\" arg:\"agent-dir\" env:\"AGENT_DIR\" usage:\"Agent directory with .claude/ config\" default:\"agent\"`\n78\t\n79\t\t// Allowed tools (comma-separated)\n80\t\tAllowedToolsRaw string `required:\"false\" arg:\"allowed-tools\" env:\"ALLOWED_TOOLS\" usage:\"Comma-separated list of allowed tools\"`\n81\t\n82\t\t// Task content from agent pipeline\n83\t\tTaskContent string `required:\"true\" arg:\"task-content\" env:\"TASK_CONTENT\" usage:\"Raw task markdown from vault\"`\n84\t\n85\t\t// Environment context passed to prompt (comma-separated KEY=VALUE pairs)\n86\t\tEnvContextRaw string `required:\"false\" arg:\"env-context\" env:\"ENV_CONTEXT\" usage:\"Comma-separated KEY=VALUE pairs for prompt context\"`\n87\t\n88\t\t// Environment variables passed to Claude CLI process (comma-separated KEY=VALUE pairs).\n89\t\t// Use this for ad-hoc / less-common env vars. The three load-bearing Anthropic provider\n90\t\t// vars below have dedicated arg slots so they don't have to be packed into this string.\n91\t\tClaudeEnvRaw string `required:\"false\" arg:\"claude-env\" env:\"CLAUDE_ENV\" usage:\"Comma-separated KEY=VALUE pairs for Claude CLI environment\"`\n92\t\n93\t\t// Anthropic-compatible provider routing. Setting AnthropicBaseURL + AnthropicAuthToken\n94\t\t// routes the claude CLI to an alt-provider (e.g. MiniMax via https://api.minimax.io/anthropic).\n95\t\t// AnthropicModel drives both the `--model` CLI flag and the ANTHROPIC_MODEL env var seen by\n96\t\t// the claude subprocess. Non-empty values override the same keys in ClaudeEnvRaw.\n97\t\tAnthropicBaseURL   string                `required:\"false\" arg:\"anthropic-base-url\"   env:\"ANTHROPIC_BASE_URL\"   usage:\"Anthropic-compatible API base URL\"`\n98\t\tAnthropicAuthToken string                `required:\"false\" arg:\"anthropic-auth-token\" env:\"ANTHROPIC_AUTH_TOKEN\" usage:\"Bearer token for ANTHROPIC_BASE_URL\"                                  display:\"length\"`\n99\t\tAnthropicModel     claudelib.ClaudeModel `required:\"false\" arg:\"anthropic-model\"      env:\"ANTHROPIC_MODEL\"      usage:\"Model name; also exposed to the claude subprocess as ANTHROPIC_MODEL\"                  default:\"sonnet\"`\n100\t\n101\t\t// Branch for Kafka result delivery\n102\t\tBranch base.Branch `required:\"false\" arg:\"branch\" env:\"BRANCH\" usage:\"branch\"`\n103\t\n104\t\t// Explicit Kafka topic prefix (independent of Branch; empty means unprefixed topics)\n105\t\tTopicPrefix base.TopicPrefix `required:\"false\" arg:\"topic-prefix\" env:\"TOPIC_PREFIX\" usage:\"Explicit Kafka topic prefix; empty means unprefixed topics\"`\n106\t\n107\t\t// Stage is the deployment stage (dev|prod), forwarded to the collector script\n108\t\t// as STAGE so scripts/sentry-create-tasks.sh can pass --stage to\n109\t\t// /create-tasks. Empty means the collector script's default (dev).\n110\t\tStage string `required:\"false\" arg:\"stage\" env:\"STAGE\" usage:\"Deployment stage (dev|prod); forwarded to the collector script\"`\n111\t\n112\t\t// TargetVault is the Obsidian vault slug the collector's /create-tasks\n113\t\t// publishes per-alert tasks into (e.g. \"personal\"), forwarded to the\n114\t\t// collector script as TARGET_VAULT.\n115\t\tTargetVault string `required:\"false\" arg:\"target-vault\" env:\"TARGET_VAULT\" usage:\"Obsidian vault slug for collector-published per-alert tasks\"`\n116\t\n117\t\t// Phase to run (framework requires explicit phase)\n118\t\tPhase domain.TaskPhase `required:\"false\" arg:\"phase\" env:\"PHASE\" usage:\"Agent phase: planning | execution | ai_review\" default:\"execution\"`\n119\t\n120\t\t// Kafka delivery (optional — only active when TASK_ID is set)\n121\t\tKafkaBrokers libkafka.Brokers        `required:\"false\" arg:\"kafka-brokers\" env:\"KAFKA_BROKERS\" usage:\"Comma separated list of Kafka brokers\"`\n122\t\tTaskID       agentlib.TaskIdentifier `required:\"false\" arg:\"task-id\"       env:\"TASK_ID\"       usage:\"Agent task identifier for publishing results back to task controller\"`\n123\t\n124\t\tPushgatewayURL string `required:\"false\" arg:\"pushgateway-url\" env:\"PUSHGATEWAY_URL\" usage:\"Prometheus PushGateway URL\"          default:\"http://pushgateway:9090\"`\n125\t\tTaskType       string `required:\"false\" arg:\"task-type\"       env:\"TASK_TYPE\"       usage:\"Task type label for metric grouping\" default:\"unknown\"`\n126\t}\n127\t\n128\t// createDeliverer builds the Kafka-or-Noop result deliverer. Empty taskID\n129\t// means \"no Kafka\" — returns a noop deliverer and an empty cleanup. Non-empty\n130\t// taskID requires non-empty brokers; the cleanup closes the SyncProducer.\n131\t// Boot-time decision, kept in main.go (per go-factory-pattern: factories\n132\t// compose, main.go interprets config + owns lifecycle).\n133\tfunc (a *application) createDeliverer(\n134\t\tctx context.Context,\n135\t) (agentlib.ResultDeliverer, func(), error) {\n136\t\tif a.TaskID == \"\" {\n137\t\t\treturn delivery.NewNoopResultDeliverer(), func() {}, nil\n138\t\t}\n139\t\tif len(a.KafkaBrokers) == 0 {\n140\t\t\treturn nil, nil, errors.Errorf(ctx, \"KAFKA_BROKERS must be set when TASK_ID is set\")\n141\t\t}\n142\t\tsyncProducer, err := libkafka.NewSyncProducerWithName(\n143\t\t\tctx,\n144\t\t\ta.KafkaBrokers,\n145\t\t\t\"agent-sentry-issue-analyzer\",\n146\t\t)\n147\t\tif err != nil {\n148\t\t\treturn nil, nil, errors.Wrap(ctx, err, \"create sync producer\")\n149\t\t}\n150\t\tcleanup := func() {\n151\t\t\tif err := syncProducer.Close(); err != nil {\n152\t\t\t\tglog.Warningf(\"close sync producer failed: %v\", err)\n153\t\t\t}\n154\t\t}\n155\t\treturn factory.CreateKafkaResultDeliverer(\n156\t\t\tsyncProducer, a.TopicPrefix, a.TaskID, a.TaskContent,\n157\t\t\tlibtime.NewCurrentDateTime(),\n158\t\t), cleanup, nil\n159\t}\n160\t\n161\t// buildClaudeEnv assembles the environment passed to the Claude CLI subprocess.\n162\t// The claude CLI runs prompt scripts (Bash tool) in a subprocess env built from\n163\t// an allowlist + CLAUDE_CONFIG_DIR + this map, so anything a script needs (the\n164\t// Sentry token, the repo-clone GitHub token) must be forwarded here — the pod\n165\t// secret alone is not enough (buildSubprocessEnv strips non-allowlisted vars).\n166\t// Errors are wrapped for the caller to record metrics + return.\n167\tfunc (a *application) buildClaudeEnv(ctx context.Context) (map[string]string, error) {\n168\t\tclaudeEnv := envparse.KeyValuePairs(a.ClaudeEnvRaw)\n169\t\tif claudeEnv == nil {\n170\t\t\tclaudeEnv = map[string]string{}\n171\t\t}\n172\t\tif a.AnthropicBaseURL != \"\" {\n173\t\t\tclaudeEnv[\"ANTHROPIC_BASE_URL\"] = a.AnthropicBaseURL\n174\t\t}\n175\t\tif a.AnthropicAuthToken != \"\" {\n176\t\t\tclaudeEnv[\"ANTHROPIC_AUTH_TOKEN\"] = a.AnthropicAuthToken\n177\t\t}\n178\t\tif a.AnthropicModel != \"\" {\n179\t\t\tclaudeEnv[\"ANTHROPIC_MODEL\"] = a.AnthropicModel.String()\n180\t\t}\n181\t\t// The Sentry REST token: the main binary reads it for preflight, and the\n182\t\t// Bash tool contract (scripts/sentry-read.sh) needs it in the subprocess env.\n183\t\tif a.SentryAPIToken != \"\" {\n184\t\t\tclaudeEnv[\"SENTRY_API_TOKEN\"] = a.SentryAPIToken\n185\t\t}\n186\t\t// The collector step's Bash tool contract (scripts/sentry-create-tasks.sh)\n187\t\t// needs the Kafka brokers + per-alert task knobs in the subprocess env —\n188\t\t// the pod secret alone is not enough (buildSubprocessEnv strips\n189\t\t// non-allowlisted vars). Forward only when non-empty.\n190\t\tif len(a.KafkaBrokers) > 0 {\n191\t\t\tclaudeEnv[\"KAFKA_BROKERS\"] = a.KafkaBrokers.String()\n192\t\t}\n193\t\tif a.TopicPrefix != \"\" {\n194\t\t\tclaudeEnv[\"TOPIC_PREFIX\"] = string(a.TopicPrefix)\n195\t\t}\n196\t\tif a.TargetVault != \"\" {\n197\t\t\tclaudeEnv[\"TARGET_VAULT\"] = a.TargetVault\n198\t\t}\n199\t\tif a.Stage != \"\" {\n200\t\t\tclaudeEnv[\"STAGE\"] = a.Stage\n201\t\t}\n202\t\t// Mint a GitHub App installation token and expose it as GIT_CLONE_TOKEN so\n203\t\t// scripts/repo-clone.sh can clone private bborbe/seibert repos (e.g. trading).\n204\t\t// Same shared App as github-pr-review-agent. Optional: when App auth is not\n205\t\t// configured, no GIT_CLONE_TOKEN is set and repo-clone.sh only clones public\n206\t\t// repos.\n207\t\tif a.AppID != 0 && a.InstallationID != 0 && a.PEMKey != \"\" {\n208\t\t\tiat, err := githubapp.MintIAT(ctx, githubapp.Config{\n209\t\t\t\tAppID:          a.AppID,\n210\t\t\t\tInstallationID: a.InstallationID,\n211\t\t\t\tPEM:            []byte(a.PEMKey),\n212\t\t\t})\n213\t\t\tif err != nil {\n214\t\t\t\treturn nil, errors.Wrap(ctx, err, \"mint github app iat\")\n215\t\t\t}\n216\t\t\tclaudeEnv[\"GIT_CLONE_TOKEN\"] = iat\n217\t\t}\n218\t\treturn claudeEnv, nil\n219\t}\n220\t\n221\t// validatePreflight runs the task-type-appropriate fail-fast tool/token check.\n222\t// The collector step uses its own constrained script (scripts/sentry-create-tasks.sh)\n223\t// instead of sentry-read.sh / repo-clone.sh, so it is preflighted against its\n224\t// own tool contract; all other task types keep the triage/deep checks.\n225\tfunc (a *application) validatePreflight(\n226\t\tctx context.Context,\n227\t\tallowedTools claudelib.AllowedTools,\n228\t) error {\n229\t\tif a.TaskType == taskTypeSentryCollector {\n230\t\t\treturn errors.Wrap(\n231\t\t\t\tctx,\n232\t\t\t\tpreflight.ValidateCollectorTools(ctx, allowedTools, a.SentryAPIToken),\n233\t\t\t\t\"sentry-collector preflight\",\n234\t\t\t)\n235\t\t}\n236\t\tif err := preflight.ValidateSentryTools(ctx, allowedTools, a.SentryAPIToken); err != nil {\n237\t\t\treturn errors.Wrap(ctx, err, \"sentry preflight\")\n238\t\t}\n239\t\tif err := preflight.ValidateRepoCloneTools(ctx, allowedTools); err != nil {\n240\t\t\treturn errors.Wrap(ctx, err, \"repo-clone preflight\")\n241\t\t}\n242\t\treturn nil\n243\t}\n244\t\n245\tfunc (a *application) Run(ctx context.Context, _ libsentry.Client) error {\n246\t\tregistry := prometheus.NewRegistry()\n247\t\tjobMetrics := libmetrics.NewJobMetrics(registry, libtime.NewCurrentDateTime())\n248\t\tpusher := push.New(a.PushgatewayURL, libmetrics.BuildJobMetricsName(agentName)).\n249\t\t\tGrouping(\"agent\", agentName).\n250\t\t\tGrouping(\"task_type\", a.TaskType).\n251\t\t\tCollector(registry)\n252\t\tdefer func() {\n253\t\t\tif err := pusher.PushContext(ctx); err != nil {\n254\t\t\t\tglog.Warningf(\"prometheus push failed: %v\", err)\n255\t\t\t\treturn\n256\t\t\t}\n257\t\t\tglog.V(2).Infof(\"prometheus push completed\")\n258\t\t}()\n259\t\tstart := libtime.NewCurrentDateTime().Now().Time()\n260\t\n261\t\tglog.V(2).Infof(\"agent-sentry-issue-analyzer started phase=%s\", a.Phase)\n262\t\n263\t\tdeliverer, cleanup, err := a.createDeliverer(ctx)\n264\t\tif err != nil {\n265\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n266\t\t\tjobMetrics.RecordDuration(time.Since(start))\n267\t\t\treturn errors.Wrap(ctx, err, \"create deliverer\")\n268\t\t}\n269\t\tdefer cleanup()\n270\t\n271\t\tclaudeEnv, err := a.buildClaudeEnv(ctx)\n272\t\tif err != nil {\n273\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n274\t\t\tjobMetrics.RecordDuration(time.Since(start))\n275\t\t\treturn err\n276\t\t}\n277\t\n278\t\tallowedTools := claudelib.ParseAllowedTools(a.AllowedToolsRaw)\n279\t\tif err := a.validatePreflight(ctx, allowedTools); err != nil {\n280\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n281\t\t\tjobMetrics.RecordDuration(time.Since(start))\n282\t\t\treturn err\n283\t\t}\n284\t\n285\t\tprovider := factory.CreateAgentProvider(\n286\t\t\ta.ClaudeConfigDir,\n287\t\t\ta.AgentDir,\n288\t\t\tclaudelib.ParseAllowedTools(a.AllowedToolsRaw),\n289\t\t\ta.AnthropicModel,\n290\t\t\tclaudeEnv,\n291\t\t\tenvparse.KeyValuePairs(a.EnvContextRaw),\n292\t\t)\n293\t\tagent, err := provider.Get(ctx, agentlib.TaskType(a.TaskType))\n294\t\tif err != nil {\n295\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n296\t\t\tjobMetrics.RecordDuration(time.Since(start))\n297\t\t\treturn errors.Wrap(ctx, err, \"select agent for task_type\")\n298\t\t}\n299\t\n300\t\tresult, err := agent.Run(ctx, a.Phase, a.TaskContent, deliverer)\n301\t\tif err != nil {\n302\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n303\t\t\tjobMetrics.RecordDuration(time.Since(start))\n304\t\t\treturn errors.Wrap(ctx, err, \"agent run failed\")\n305\t\t}\n306\t\tif result == nil {\n307\t\t\t// agent.Run returns (nil, nil) when every step in the phase skipped\n308\t\t\t// (ShouldRun=false, e.g. the phase's output section already exists from\n309\t\t\t// a prior run) — treat as a no-op completion rather than panicking.\n310\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n311\t\t\tjobMetrics.RecordDuration(time.Since(start))\n312\t\t\treturn errors.Errorf(\n313\t\t\t\tctx,\n314\t\t\t\t\"agent run returned nil result (all steps skipped for phase %s)\",\n315\t\t\t\ta.Phase,\n316\t\t\t)\n317\t\t}\n318\t\tjobMetrics.RecordRun(result.Status)\n319\t\tjobMetrics.RecordDuration(time.Since(start))\n320\t\treturn agentlib.PrintResult(ctx, result)\n321\t}\n322\t"}]},"parent_tool_use_id":null,"session_id":"0569d43e-8a8a-43f7-b8e3-deb908a82fc1","uuid":"dbfa8e04-14fe-4d20-96f4-f2038d127240","timestamp":"2026-09-03T19:46:00.381Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/main.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\n// Command agent-sentry-issue-analyzer is the canonical AI-heavy agent: one Claude\n// invocation per phase, all logic in the prompt + allowed tools.\n//\n// This binary is the Kafka entry point — spawned as a K8s Job by\n// task/executor with TASK_CONTENT + TASK_ID + PHASE + KAFKA_BROKERS env.\n// For local CLI mode (file-based), see cmd/run-task/main.go.\n//\n// Reference implementation for AI-heavy agents using the agent framework\n// (lib.NewAgent + claude.NewAgentStep). Other agents (trade-analysis,\n// pr-reviewer) follow the same shape — copy this main.go and swap\n// prompts/tools.\npackage main\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"time\"\n\n\tagentlib \"github.com/bborbe/agent\"\n\tclaudelib \"github.com/bborbe/agent/claude\"\n\tdelivery \"github.com/bborbe/agent/delivery\"\n\t\"github.com/bborbe/agent/envparse\"\n\tlibmetrics \"github.com/bborbe/agent/metrics\"\n\t\"github.com/bborbe/cqrs/base\"\n\t\"github.com/bborbe/errors\"\n\tlibkafka \"github.com/bborbe/kafka\"\n\t\"github.com/bborbe/maintainer/githubapp\"\n\tlibsentry \"github.com/bborbe/sentry\"\n\t\"github.com/bborbe/service\"\n\tlibtime \"github.com/bborbe/time\"\n\t\"github.com/bborbe/vault-cli/pkg/domain\"\n\t\"github.com/golang/glog\"\n\t\"github.com/prometheus/client_golang/prometheus\"\n\t\"github.com/prometheus/client_golang/prometheus/push\"\n\n\t\"github.com/bborbe/agent-sentry-issue-analyzer/pkg/factory\"\n\t\"github.com/bborbe/agent-sentry-issue-analyzer/pkg/preflight\"\n)\n\n// agentName is the identity string used for Prometheus metric grouping and logging.\nconst agentName = \"claude-agent\"\n\n// taskTypeSentryCollector is the collector step's task-type literal (mirrors\n// factory.taskTypeSentryCollector). The collector has a single planning phase and\n// a different tool contract (scripts/sentry-create-tasks.sh instead of\n// sentry-read.sh / repo-clone.sh), so it gets its own preflight.\nconst taskTypeSentryCollector = \"sentry-collector\"\n\nfunc main() {\n\tapp := &application{}\n\tos.Exit(service.Main(context.Background(), app, &app.SentryDSN, &app.SentryProxy))\n}\n\ntype application struct {\n\tSentryDSN      string `required:\"false\" arg:\"sentry-dsn\"       env:\"SENTRY_DSN\"       usage:\"SentryDSN\"                                        display:\"length\"`\n\tSentryProxy    string `required:\"false\" arg:\"sentry-proxy\"     env:\"SENTRY_PROXY\"     usage:\"Sentry Proxy\"                                     display:\"length\"`\n\tSentryAPIToken string `required:\"true\"  arg:\"sentry-api-token\" env:\"SENTRY_API_TOKEN\" usage:\"Sentry REST API Bearer token (teamvault-sourced)\" display:\"length\"`\n\n\t// GitHub App auth for read-only cloning of private repos (repo-clone.sh).\n\t// The pod mints an installation access token at startup (same pattern as\n\t// github-pr-review-agent resolveAuth) and exposes it to the Claude\n\t// subprocess as GIT_CLONE_TOKEN so repo-clone.sh can clone private\n\t// bborbe/seibert repos. APP_ID + INSTALLATION_ID + one of PEM/PEM_KEY are\n\t// required for App auth.\n\tAppID          int64  `required:\"false\" arg:\"app-id\"          env:\"APP_ID\"          usage:\"GitHub App ID (numeric); required for App auth\"`\n\tInstallationID int64  `required:\"false\" arg:\"installation-id\" env:\"INSTALLATION_ID\" usage:\"GitHub App installation ID; required for App auth\"`\n\tPEMKey         string `required:\"false\" arg:\"pem-key\"         env:\"PEM_KEY\"         usage:\"GitHub App private key (PEM) as env var content\"   display:\"length\"`\n\n\t// Claude Code CLI configuration\n\tClaudeConfigDir claudelib.ClaudeConfigDir `required:\"false\" arg:\"claude-config-dir\" env:\"CLAUDE_CONFIG_DIR\" usage:\"Claude Code config directory\"`\n\n\t// Agent directory (contains .claude/ with CLAUDE.md and commands)\n\tAgentDir claudelib.AgentDir `required:\"false\" arg:\"agent-dir\" env:\"AGENT_DIR\" usage:\"Agent directory with .claude/ config\" default:\"agent\"`\n\n\t// Allowed tools (comma-separated)\n\tAllowedToolsRaw string `required:\"false\" arg:\"allowed-tools\" env:\"ALLOWED_TOOLS\" usage:\"Comma-separated list of allowed tools\"`\n\n\t// Task content from agent pipeline\n\tTaskContent string `required:\"true\" arg:\"task-content\" env:\"TASK_CONTENT\" usage:\"Raw task markdown from vault\"`\n\n\t// Environment context passed to prompt (comma-separated KEY=VALUE pairs)\n\tEnvContextRaw string `required:\"false\" arg:\"env-context\" env:\"ENV_CONTEXT\" usage:\"Comma-separated KEY=VALUE pairs for prompt context\"`\n\n\t// Environment variables passed to Claude CLI process (comma-separated KEY=VALUE pairs).\n\t// Use this for ad-hoc / less-common env vars. The three load-bearing Anthropic provider\n\t// vars below have dedicated arg slots so they don't have to be packed into this string.\n\tClaudeEnvRaw string `required:\"false\" arg:\"claude-env\" env:\"CLAUDE_ENV\" usage:\"Comma-separated KEY=VALUE pairs for Claude CLI environment\"`\n\n\t// Anthropic-compatible provider routing. Setting AnthropicBaseURL + AnthropicAuthToken\n\t// routes the claude CLI to an alt-provider (e.g. MiniMax via https://api.minimax.io/anthropic).\n\t// AnthropicModel drives both the `--model` CLI flag and the ANTHROPIC_MODEL env var seen by\n\t// the claude subprocess. Non-empty values override the same keys in ClaudeEnvRaw.\n\tAnthropicBaseURL   string                `required:\"false\" arg:\"anthropic-base-url\"   env:\"ANTHROPIC_BASE_URL\"   usage:\"Anthropic-compatible API base URL\"`\n\tAnthropicAuthToken string                `required:\"false\" arg:\"anthropic-auth-token\" env:\"ANTHROPIC_AUTH_TOKEN\" usage:\"Bearer token for ANTHROPIC_BASE_URL\"                                  display:\"length\"`\n\tAnthropicModel     claudelib.ClaudeModel `required:\"false\" arg:\"anthropic-model\"      env:\"ANTHROPIC_MODEL\"      usage:\"Model name; also exposed to the claude subprocess as ANTHROPIC_MODEL\"                  default:\"sonnet\"`\n\n\t// Branch for Kafka result delivery\n\tBranch base.Branch `required:\"false\" arg:\"branch\" env:\"BRANCH\" usage:\"branch\"`\n\n\t// Explicit Kafka topic prefix (independent of Branch; empty means unprefixed topics)\n\tTopicPrefix base.TopicPrefix `required:\"false\" arg:\"topic-prefix\" env:\"TOPIC_PREFIX\" usage:\"Explicit Kafka topic prefix; empty means unprefixed topics\"`\n\n\t// Stage is the deployment stage (dev|prod), forwarded to the collector script\n\t// as STAGE so scripts/sentry-create-tasks.sh can pass --stage to\n\t// /create-tasks. Empty means the collector script's default (dev).\n\tStage string `required:\"false\" arg:\"stage\" env:\"STAGE\" usage:\"Deployment stage (dev|prod); forwarded to the collector script\"`\n\n\t// TargetVault is the Obsidian vault slug the collector's /create-tasks\n\t// publishes per-alert tasks into (e.g. \"personal\"), forwarded to the\n\t// collector script as TARGET_VAULT.\n\tTargetVault string `required:\"false\" arg:\"target-vault\" env:\"TARGET_VAULT\" usage:\"Obsidian vault slug for collector-published per-alert tasks\"`\n\n\t// Phase to run (framework requires explicit phase)\n\tPhase domain.TaskPhase `required:\"false\" arg:\"phase\" env:\"PHASE\" usage:\"Agent phase: planning | execution | ai_review\" default:\"execution\"`\n\n\t// Kafka delivery (optional — only active when TASK_ID is set)\n\tKafkaBrokers libkafka.Brokers        `required:\"false\" arg:\"kafka-brokers\" env:\"KAFKA_BROKERS\" usage:\"Comma separated list of Kafka brokers\"`\n\tTaskID       agentlib.TaskIdentifier `required:\"false\" arg:\"task-id\"       env:\"TASK_ID\"       usage:\"Agent task identifier for publishing results back to task controller\"`\n\n\tPushgatewayURL string `required:\"false\" arg:\"pushgateway-url\" env:\"PUSHGATEWAY_URL\" usage:\"Prometheus PushGateway URL\"          default:\"http://pushgateway:9090\"`\n\tTaskType       string `required:\"false\" arg:\"task-type\"       env:\"TASK_TYPE\"       usage:\"Task type label for metric grouping\" default:\"unknown\"`\n}\n\n// createDeliverer builds the Kafka-or-Noop result deliverer. Empty taskID\n// means \"no Kafka\" — returns a noop deliverer and an empty cleanup. Non-empty\n// taskID requires non-empty brokers; the cleanup closes the SyncProducer.\n// Boot-time decision, kept in main.go (per go-factory-pattern: factories\n// compose, main.go interprets config + owns lifecycle).\nfunc (a *application) createDeliverer(\n\tctx context.Context,\n) (agentlib.ResultDeliverer, func(), error) {\n\tif a.TaskID == \"\" {\n\t\treturn delivery.NewNoopResultDeliverer(), func() {}, nil\n\t}\n\tif len(a.KafkaBrokers) == 0 {\n\t\treturn nil, nil, errors.Errorf(ctx, \"KAFKA_BROKERS must be set when TASK_ID is set\")\n\t}\n\tsyncProducer, err := libkafka.NewSyncProducerWithName(\n\t\tctx,\n\t\ta.KafkaBrokers,\n\t\t\"agent-sentry-issue-analyzer\",\n\t)\n\tif err != nil {\n\t\treturn nil, nil, errors.Wrap(ctx, err, \"create sync producer\")\n\t}\n\tcleanup := func() {\n\t\tif err := syncProducer.Close(); err != nil {\n\t\t\tglog.Warningf(\"close sync producer failed: %v\", err)\n\t\t}\n\t}\n\treturn factory.CreateKafkaResultDeliverer(\n\t\tsyncProducer, a.TopicPrefix, a.TaskID, a.TaskContent,\n\t\tlibtime.NewCurrentDateTime(),\n\t), cleanup, nil\n}\n\n// buildClaudeEnv assembles the environment passed to the Claude CLI subprocess.\n// The claude CLI runs prompt scripts (Bash tool) in a subprocess env built from\n// an allowlist + CLAUDE_CONFIG_DIR + this map, so anything a script needs (the\n// Sentry token, the repo-clone GitHub token) must be forwarded here — the pod\n// secret alone is not enough (buildSubprocessEnv strips non-allowlisted vars).\n// Errors are wrapped for the caller to record metrics + return.\nfunc (a *application) buildClaudeEnv(ctx context.Context) (map[string]string, error) {\n\tclaudeEnv := envparse.KeyValuePairs(a.ClaudeEnvRaw)\n\tif claudeEnv == nil {\n\t\tclaudeEnv = map[string]string{}\n\t}\n\tif a.AnthropicBaseURL != \"\" {\n\t\tclaudeEnv[\"ANTHROPIC_BASE_URL\"] = a.AnthropicBaseURL\n\t}\n\tif a.AnthropicAuthToken != \"\" {\n\t\tclaudeEnv[\"ANTHROPIC_AUTH_TOKEN\"] = a.AnthropicAuthToken\n\t}\n\tif a.AnthropicModel != \"\" {\n\t\tclaudeEnv[\"ANTHROPIC_MODEL\"] = a.AnthropicModel.String()\n\t}\n\t// The Sentry REST token: the main binary reads it for preflight, and the\n\t// Bash tool contract (scripts/sentry-read.sh) needs it in the subprocess env.\n\tif a.SentryAPIToken != \"\" {\n\t\tclaudeEnv[\"SENTRY_API_TOKEN\"] = a.SentryAPIToken\n\t}\n\t// The collector step's Bash tool contract (scripts/sentry-create-tasks.sh)\n\t// needs the Kafka brokers + per-alert task knobs in the subprocess env —\n\t// the pod secret alone is not enough (buildSubprocessEnv strips\n\t// non-allowlisted vars). Forward only when non-empty.\n\tif len(a.KafkaBrokers) > 0 {\n\t\tclaudeEnv[\"KAFKA_BROKERS\"] = a.KafkaBrokers.String()\n\t}\n\tif a.TopicPrefix != \"\" {\n\t\tclaudeEnv[\"TOPIC_PREFIX\"] = string(a.TopicPrefix)\n\t}\n\tif a.TargetVault != \"\" {\n\t\tclaudeEnv[\"TARGET_VAULT\"] = a.TargetVault\n\t}\n\tif a.Stage != \"\" {\n\t\tclaudeEnv[\"STAGE\"] = a.Stage\n\t}\n\t// Mint a GitHub App installation token and expose it as GIT_CLONE_TOKEN so\n\t// scripts/repo-clone.sh can clone private bborbe/seibert repos (e.g. trading).\n\t// Same shared App as github-pr-review-agent. Optional: when App auth is not\n\t// configured, no GIT_CLONE_TOKEN is set and repo-clone.sh only clones public\n\t// repos.\n\tif a.AppID != 0 && a.InstallationID != 0 && a.PEMKey != \"\" {\n\t\tiat, err := githubapp.MintIAT(ctx, githubapp.Config{\n\t\t\tAppID:          a.AppID,\n\t\t\tInstallationID: a.InstallationID,\n\t\t\tPEM:            []byte(a.PEMKey),\n\t\t})\n\t\tif err != nil {\n\t\t\treturn nil, errors.Wrap(ctx, err, \"mint github app iat\")\n\t\t}\n\t\tclaudeEnv[\"GIT_CLONE_TOKEN\"] = iat\n\t}\n\treturn claudeEnv, nil\n}\n\n// validatePreflight runs the task-type-appropriate fail-fast tool/token check.\n// The collector step uses its own constrained script (scripts/sentry-create-tasks.sh)\n// instead of sentry-read.sh / repo-clone.sh, so it is preflighted against its\n// own tool contract; all other task types keep the triage/deep checks.\nfunc (a *application) validatePreflight(\n\tctx context.Context,\n\tallowedTools claudelib.AllowedTools,\n) error {\n\tif a.TaskType == taskTypeSentryCollector {\n\t\treturn errors.Wrap(\n\t\t\tctx,\n\t\t\tpreflight.ValidateCollectorTools(ctx, allowedTools, a.SentryAPIToken),\n\t\t\t\"sentry-collector preflight\",\n\t\t)\n\t}\n\tif err := preflight.ValidateSentryTools(ctx, allowedTools, a.SentryAPIToken); err != nil {\n\t\treturn errors.Wrap(ctx, err, \"sentry preflight\")\n\t}\n\tif err := preflight.ValidateRepoCloneTools(ctx, allowedTools); err != nil {\n\t\treturn errors.Wrap(ctx, err, \"repo-clone preflight\")\n\t}\n\treturn nil\n}\n\nfunc (a *application) Run(ctx context.Context, _ libsentry.Client) error {\n\tregistry := prometheus.NewRegistry()\n\tjobMetrics := libmetrics.NewJobMetrics(registry, libtime.NewCurrentDateTime())\n\tpusher := push.New(a.PushgatewayURL, libmetrics.BuildJobMetricsName(agentName)).\n\t\tGrouping(\"agent\", agentName).\n\t\tGrouping(\"task_type\", a.TaskType).\n\t\tCollector(registry)\n\tdefer func() {\n\t\tif err := pusher.PushContext(ctx); err != nil {\n\t\t\tglog.Warningf(\"prometheus push failed: %v\", err)\n\t\t\treturn\n\t\t}\n\t\tglog.V(2).Infof(\"prometheus push completed\")\n\t}()\n\tstart := libtime.NewCurrentDateTime().Now().Time()\n\n\tglog.V(2).Infof(\"agent-sentry-issue-analyzer started phase=%s\", a.Phase)\n\n\tdeliverer, cleanup, err := a.createDeliverer(ctx)\n\tif err != nil {\n\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n\t\tjobMetrics.RecordDuration(time.Since(start))\n\t\treturn errors.Wrap(ctx, err, \"create deliverer\")\n\t}\n\tdefer cleanup()\n\n\tclaudeEnv, err := a.buildClaudeEnv(ctx)\n\tif err != nil {\n\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n\t\tjobMetrics.RecordDuration(time.Since(start))\n\t\treturn err\n\t}\n\n\tallowedTools := claudelib.ParseAllowedTools(a.AllowedToolsRaw)\n\tif err := a.validatePreflight(ctx, allowedTools); err != nil {\n\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n\t\tjobMetrics.RecordDuration(time.Since(start))\n\t\treturn err\n\t}\n\n\tprovider := factory.CreateAgentProvider(\n\t\ta.ClaudeConfigDir,\n\t\ta.AgentDir,\n\t\tclaudelib.ParseAllowedTools(a.AllowedToolsRaw),\n\t\ta.AnthropicModel,\n\t\tclaudeEnv,\n\t\tenvparse.KeyValuePairs(a.EnvContextRaw),\n\t)\n\tagent, err := provider.Get(ctx, agentlib.TaskType(a.TaskType))\n\tif err != nil {\n\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n\t\tjobMetrics.RecordDuration(time.Since(start))\n\t\treturn errors.Wrap(ctx, err, \"select agent for task_type\")\n\t}\n\n\tresult, err := agent.Run(ctx, a.Phase, a.TaskContent, deliverer)\n\tif err != nil {\n\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n\t\tjobMetrics.RecordDuration(time.Since(start))\n\t\treturn errors.Wrap(ctx, err, \"agent run failed\")\n\t}\n\tif result == nil {\n\t\t// agent.Run returns (nil, nil) when every step in the phase skipped\n\t\t// (ShouldRun=false, e.g. the phase's output section already exists from\n\t\t// a prior run) — treat as a no-op completion rather than panicking.\n\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n\t\tjobMetrics.RecordDuration(time.Since(start))\n\t\treturn errors.Errorf(\n\t\t\tctx,\n\t\t\t\"agent run returned nil result (all steps skipped for phase %s)\",\n\t\t\ta.Phase,\n\t\t)\n\t}\n\tjobMetrics.RecordRun(result.Status)\n\tjobMetrics.RecordDuration(time.Since(start))\n\treturn agentlib.PrintResult(ctx, result)\n}\n","numLines":322,"startLine":1,"totalLines":322}}}
