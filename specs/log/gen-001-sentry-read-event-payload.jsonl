{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-82dd7e663b06d18b","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# Constrained read-only Sentry fetcher — replaces the mcp__sentry__* MCP tools.\n3\t#\n4\t# Usage: sentry-read.sh <issue-url-or-id>\n5\t#   e.g. sentry-read.sh https://bborbe.sentry.io/issues/5192501045/\n6\t#   or   sentry-read.sh 5192501045\n7\t#\n8\t# Emits the LIVE issue state the verdict rubric needs, as a flat key=value block:\n9\t#   short_id, status, live_event_count, first_seen, last_seen, users_impacted, title\n10\t#\n11\t# Env: SENTRY_API_TOKEN (required, Bearer token), SENTRY_ORG (default bborbe),\n12\t#      SENTRY_URL (default https://bborbe.sentry.io)\n13\t#\n14\t# Read-only by construction: single GET, no mutations, no shell metacharacter\n15\t# interpolation into the URL (issue id is validated to [0-9]+).\n16\t\n17\tset -euo pipefail\n18\t\n19\t: \"${SENTRY_API_TOKEN:?SENTRY_API_TOKEN is required}\"\n20\tSENTRY_URL=\"${SENTRY_URL:-https://bborbe.sentry.io}\"\n21\tSENTRY_ORG=\"${SENTRY_ORG:-bborbe}\"\n22\t\n23\tissue_id=\"${1:-}\"\n24\tif [ -z \"$issue_id\" ]; then\n25\t  echo \"usage: sentry-read.sh <issue-url-or-id>\" >&2\n26\t  exit 2\n27\tfi\n28\t\n29\t# Extract a numeric issue id from a URL like .../issues/1234567890/ or accept a bare id.\n30\tissue_id=\"$(printf '%s' \"$issue_id\" | sed -nE 's#.*/issues/([0-9]+)/?.*#\\1#p')\"\n31\tif [ -z \"$issue_id\" ]; then\n32\t  echo \"could not extract a numeric Sentry issue id from: $1\" >&2\n33\t  exit 2\n34\tfi\n35\t\n36\tresponse=\"$(curl -fsS --max-time 30 \\\n37\t  -H \"Authorization: Bearer ${SENTRY_API_TOKEN}\" \\\n38\t  \"${SENTRY_URL}/api/0/organizations/${SENTRY_ORG}/issues/${issue_id}/\")\"\n39\t\n40\t# Emit the fields the verdict rubric consumes, in a stable order.\n41\tprintf 'short_id=%s\\n'    \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"shortId\"])')\"\n42\tprintf 'status=%s\\n'      \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"status\"])')\"\n43\tprintf 'live_event_count=%s\\n' \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"count\"])')\"\n44\tprintf 'first_seen=%s\\n'  \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"firstSeen\"])')\"\n45\tprintf 'last_seen=%s\\n'   \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"lastSeen\"])')\"\n46\tprintf 'users_impacted=%s\\n' \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"userCount\"])')\"\n47\tprintf 'title=%s\\n'       \"$(printf '%s' \"$response\" | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"title\"])')\"\n48\t"}]},"parent_tool_use_id":"chatcmpl-tool-b8442ba12e371c9d","session_id":"5d6cc7de-1074-471b-be5a-1eef1a32f0f2","uuid":"65580b04-535d-41d4-a671-43597bec8efd","timestamp":"2026-08-31T22:35:03.409Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 2"}
