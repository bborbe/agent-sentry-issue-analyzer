nt).To(ContainSubstring(\"scripts/sentry-create-tasks.sh\"))\n132\t\t})\n133\t\n134\t\tIt(\"collector prompt writes the ## Analysis summary section\", func() {\n135\t\t\tinstrs := prompts.BuildCollectorPlanningInstructions()\n136\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"## Analysis\"))\n137\t\t})\n138\t\n139\t\tIt(\"collector prompt filters is:unresolved (no resolved/regressed tasks)\", func() {\n140\t\t\tinstrs := prompts.BuildCollectorPlanningInstructions()\n141\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"is:unresolved\"))\n142\t\t})\n143\t})\n144\t\n145\tvar _ = Describe(\"BuildDeepPlanningInstructions\", func() {\n146\t\tIt(\"returns exactly 2 instructions\", func() {\n147\t\t\tinstrs := prompts.BuildDeepPlanningInstructions()\n148\t\t\tExpect(instrs).To(HaveLen(2))\n149\t\t})\n150\t\n151\t\tIt(\"first instruction is deep-planning\", func() {\n152\t\t\tinstrs := prompts.BuildDeepPlanningInstructions()\n153\t\t\tExpect(instrs[0].Name).To(Equal(\"deep-planning\"))\n154\t\t\tExpect(instrs[0].Content).NotTo(BeEmpty())\n155\t\t})\n156\t\n157\t\tIt(\"second instruction is output-format\", func() {\n158\t\t\tinstrs := prompts.BuildDeepPlanningInstructions()\n159\t\t\tExpect(instrs[1].Name).To(Equal(\"output-format\"))\n160\t\t})\n161\t\n162\t\tIt(\"deep planning prompt contains the token-REST live-state script + clone\", func() {\n163\t\t\tinstrs := prompts.BuildDeepPlanningInstructions()\n164\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/sentry-read.sh\"))\n165\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/repo-clone.sh clone\"))\n166\t\t})\n167\t\n168\t\tIt(\"deep planning prompt writes the ## Context section\", func() {\n169\t\t\tinstrs := prompts.BuildDeepPlanningInstructions()\n170\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"## Context\"))\n171\t\t})\n172\t})\n173\t\n174\tvar _ = Describe(\"BuildDeepExecutionInstructions\", func() {\n175\t\tIt(\"returns exactly 2 instructions\", func() {\n176\t\t\tinstrs := prompts.BuildDeepExecutionInstructions()\n177\t\t\tExpect(instrs).To(HaveLen(2))\n178\t\t})\n179\t\n180\t\tIt(\"first instruction is deep-execution\", func() {\n181\t\t\tinstrs := prompts.BuildDeepExecutionInstructions()\n182\t\t\tExpect(instrs[0].Name).To(Equal(\"deep-execution\"))\n183\t\t\tExpect(instrs[0].Content).NotTo(BeEmpty())\n184\t\t})\n185\t\n186\t\tIt(\"deep execution prompt uses the octopus verdict vocabulary\", func() {\n187\t\t\tinstrs := prompts.BuildDeepExecutionInstructions()\n188\t\t\tfor _, v := range []string{\"real bug\", \"noise\", \"duplicate\", \"closed-fixed-in-prod\", \"not-a-defect\", \"track\"} {\n189\t\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"`\" + v + \"`\"))\n190\t\t\t}\n191\t\t})\n192\t\n193\t\tIt(\"deep execution prompt defines the octopus verdict YAML keys\", func() {\n194\t\t\tinstrs := prompts.BuildDeepExecutionInstructions()\n195\t\t\tfor _, k := range []string{\"sentry_issue_id\", \"verdict\", \"understanding\", \"fix_certainty\", \"root_cause\", \"recommended_fix\", \"file:line\", \"disqualifiers_fired\", \"live_event_count\"} {\n196\t\t\t\tExpect(instrs[0].Content).To(ContainSubstring(k))\n197\t\t\t}\n198\t\t})\n199\t\n200\t\tIt(\"deep execution prompt writes the verdict into the ## Verdict section\", func() {\n201\t\t\tinstrs := prompts.BuildDeepExecutionInstructions()\n202\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"## Verdict\"))\n203\t\t})\n204\t})\n205\t"}]},"parent_tool_use_id":"chatcmpl-tool-9081ad34b675648e","session_id":"bf6eb875-41e8-4988-a539-5dee3a13bc7d","uuid":"5ca565b6-2807-40a2-a78f-c1fd8d8b3c2c","timestamp":"2026-09-01T12:22:37.816Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 2 repo mapping"}
