{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-bddcf5a5e24655d2","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\t// Package prompts provides embedded per-phase prompt fragments for the\n6\t// Sentry analyzer agent. Each active phase (planning, execution) gets its\n7\t// own domain module; output-format.md is the shared JSON output contract.\n8\tpackage prompts\n9\t\n10\timport (\n11\t\t_ \"embed\"\n12\t\n13\t\tclaudelib \"github.com/bborbe/agent/claude\"\n14\t)\n15\t\n16\t//go:embed planning.md\n17\tvar planning string\n18\t\n19\t//go:embed execution.md\n20\tvar execution string\n21\t\n22\t//go:embed deep-planning.md\n23\tvar deepPlanning string\n24\t\n25\t//go:embed deep-execution.md\n26\tvar deepExecution string\n27\t\n28\t//go:embed collector-planning.md\n29\tvar collectorPlanning string\n30\t\n31\t//go:embed output-format.md\n32\tvar outputFormat string\n33\t\n34\t// BuildPlanningInstructions assembles the triage planning-phase prompt: the\n35\t// domain planning module plus the shared output-format contract. Used by the\n36\t// sentry-issue-analyzer task type (the daily-batch triage agent).\n37\tfunc BuildPlanningInstructions() claudelib.Instructions {\n38\t\treturn claudelib.Instructions{\n39\t\t\t{Name: \"planning\", Content: planning},\n40\t\t\t{Name: \"output-format\", Content: outputFormat},\n41\t\t}\n42\t}\n43\t\n44\t// BuildExecutionInstructions assembles the triage execution-phase prompt: the\n45\t// 6-verdict rubric + noise disqualifiers, plus the shared output-format\n46\t// contract. Used by the sentry-issue-analyzer task type.\n47\tfunc BuildExecutionInstructions() claudelib.Instructions {\n48\t\treturn claudelib.Instructions{\n49\t\t\t{Name: \"execution\", Content: execution},\n50\t\t\t{Name: \"output-format\", Content: outputFormat},\n51\t\t}\n52\t}\n53\t\n54\t// BuildCollectorPlanningInstructions assembles the collector planning-phase prompt:\n55\t// the collector module (fetch day's alerts + create per-alert tasks) plus the\n56\t// shared output-format contract. Used by the sentry-collector task type (the\n57\t// daily-batch producer step that emits per-alert tasks for the triage agent).\n58\tfunc BuildCollectorPlanningInstructions() claudelib.Instructions {\n59\t\treturn claudelib.Instructions{\n60\t\t\t{Name: \"collector-planning\", Content: collectorPlanning},\n61\t\t\t{Name: \"output-format\", Content: outputFormat},\n62\t\t}\n63\t}\n64\t\n65\t// BuildDeepPlanningInstructions assembles the deep planning-phase prompt: the\n66\t// deep root-cause module (LIVE state + read-only clone) plus the shared\n67\t// output-format contract. Used by the sentry-deep-analyzer task type.\n68\tfunc BuildDeepPlanningInstructions() claudelib.Instructions {\n69\t\treturn claudelib.Instructions{\n70\t\t\t{Name: \"deep-planning\", Content: deepPlanning},\n71\t\t\t{Name: \"output-format\", Content: outputFormat},\n72\t\t}\n73\t}\n74\t\n75\t// BuildDeepExecutionInstructions assembles the deep execution-phase prompt:\n76\t// the octopus verdict schema (U/F + file:line + disqualifiers_fired) plus the\n77\t// shared output-format contract. Used by the sentry-deep-analyzer task type.\n78\tfunc BuildDeepExecutionInstructions() claudelib.Instructions {\n79\t\treturn claudelib.Instructions{\n80\t\t\t{Name: \"deep-execution\", Content: deepExecution},\n81\t\t\t{Name: \"output-format\", Content: outputFormat},\n82\t\t}\n83\t}\n84\t"}]},"parent_tool_use_id":"chatcmpl-tool-87d319a06106acdb","session_id":"bf6eb875-41e8-4988-a539-5dee3a13bc7d","uuid":"bc839b98-9bd3-4211-914e-ac8947eac11d","timestamp":"2026-09-01T12:16:24.798Z","subagent_type":"dark-factory:prompt-creator","task_description":"Create prompts from spec"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a34d22cdd6ec3ea6","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage prompts_test\n6\t\n7\timport (\n8\t\t. \"github.com/onsi/ginkgo/v2\"\n9\t\t. \"github.com/onsi/gomega\"\n10\t\n11\t\t\"github.com/bborbe/agent-sentry-issue-analyzer/pkg/prompts\"\n12\t)\n13\t\n14\tvar _ = Describe(\"BuildPlanningInstructions (triage)\", func() {\n15\t\tIt(\"returns exactly 2 instructions\", func() {\n16\t\t\tinstrs := prompts.BuildPlanningInstructions()\n17\t\t\tExpect(instrs).To(HaveLen(2))\n18\t\t})\n19\t\n20\t\tIt(\"first instruction is planning\", func() {\n21\t\t\tinstrs := prompts.BuildPlanningInstructions()\n22\t\t\tExpect(instrs[0].Name).To(Equal(\"planning\"))\n23\t\t\tExpect(instrs[0].Content).NotTo(BeEmpty())\n24\t\t})\n25\t\n26\t\tIt(\"second instruction is output-format\", func() {\n27\t\t\tinstrs := prompts.BuildPlanningInstructions()\n28\t\t\tExpect(instrs[1].Name).To(Equal(\"output-format\"))\n29\t\t\tExpect(instrs[1].Content).NotTo(BeEmpty())\n30\t\t})\n31\t\n32\t\tIt(\"planning prompt contains the token-REST live-state script invocation\", func() {\n33\t\t\tinstrs := prompts.BuildPlanningInstructions()\n34\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/sentry-read.sh\"))\n35\t\t})\n36\t\n37\t\tIt(\"planning prompt contains the read-only repo clone invocation\", func() {\n38\t\t\tinstrs := prompts.BuildPlanningInstructions()\n39\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/repo-clone.sh clone\"))\n40\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/repo-clone.sh log\"))\n41\t\t})\n42\t\n43\t\tIt(\"planning prompt contains the ## Analysis section heading\", func() {\n44\t\t\tinstrs := prompts.BuildPlanningInstructions()\n45\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"## Analysis\"))\n46\t\t})\n47\t\n48\t\tIt(\"planning prompt instructs reading the implicated source code read-only\", func() {\n49\t\t\tinstrs := prompts.BuildPlanningInstructions()\n50\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"READ-ONLY source access\"))\n51\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"file.go:line\"))\n52\t\t})\n53\t})\n54\t\n55\tvar _ = Describe(\"output-format shared contract\", func() {\n56\t\tIt(\"mandates a fenced json block instead of forbidding fences\", func() {\n57\t\t\tinstrs := prompts.BuildPlanningInstructions()\n58\t\t\tExpect(instrs[1].Name).To(Equal(\"output-format\"))\n59\t\t\tExpect(instrs[1].Content).To(ContainSubstring(\"fenced code block\"))\n60\t\t\tExpect(instrs[1].Content).To(ContainSubstring(\"```json\"))\n61\t\t\tExpect(\n62\t\t\t\tinstrs[1].Content,\n63\t\t\t).NotTo(ContainSubstring(\"Do NOT wrap the JSON in markdown code fences\"))\n64\t\t})\n65\t})\n66\t\n67\tvar _ = Describe(\"BuildExecutionInstructions (triage)\", func() {\n68\t\tIt(\"returns exactly 2 instructions\", func() {\n69\t\t\tinstrs := prompts.BuildExecutionInstructions()\n70\t\t\tExpect(instrs).To(HaveLen(2))\n71\t\t})\n72\t\n73\t\tIt(\"first instruction is execution\", func() {\n74\t\t\tinstrs := prompts.BuildExecutionInstructions()\n75\t\t\tExpect(instrs[0].Name).To(Equal(\"execution\"))\n76\t\t\tExpect(instrs[0].Content).NotTo(BeEmpty())\n77\t\t})\n78\t\n79\t\tIt(\"execution prompt contains the noise disqualifiers\", func() {\n80\t\t\tinstrs := prompts.BuildExecutionInstructions()\n81\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"live_event_count > 10000\"))\n82\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"regressed\"))\n83\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"Do NOT use simple `<50 events = noise`\"))\n84\t\t})\n85\t\n86\t\tIt(\"execution prompt instructs live-state re-fetch before the verdict\", func() {\n87\t\t\tinstrs := prompts.BuildExecutionInstructions()\n88\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/sentry-read.sh\"))\n89\t\t})\n90\t\n91\t\tIt(\"execution prompt uses the triage 6-verdict rubric\", func() {\n92\t\t\tinstrs := prompts.BuildExecutionInstructions()\n93\t\t\tfor _, v := range []string{\"already-tracked\", \"regression\", \"real bug\", \"noise\", \"duplicate\", \"not-a-defect\"} {\n94\t\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"`\" + v + \"`\"))\n95\t\t\t}\n96\t\t})\n97\t\n98\t\tIt(\"execution prompt defines the triage verdict YAML keys\", func() {\n99\t\t\tinstrs := prompts.BuildExecutionInstructions()\n100\t\t\tfor _, k := range []string{\"sentry_issue_id\", \"verdict\", \"confidence\", \"reason\", \"live_event_count\", \"sentry_status\"} {\n101\t\t\t\tExpect(instrs[0].Content).To(ContainSubstring(k))\n102\t\t\t}\n103\t\t})\n104\t\n105\t\tIt(\"execution prompt writes the verdict into the ## Verdict section\", func() {\n106\t\t\tinstrs := prompts.BuildExecutionInstructions()\n107\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"## Verdict\"))\n108\t\t})\n109\t})\n110\t\n111\tvar _ = Describe(\"BuildCollectorPlanningInstructions\", func() {\n112\t\tIt(\"returns exactly 2 instructions\", func() {\n113\t\t\tinstrs := prompts.BuildCollectorPlanningInstructions()\n114\t\t\tExpect(instrs).To(HaveLen(2))\n115\t\t})\n116\t\n117\t\tIt(\"first instruction is collector-planning\", func() {\n118\t\t\tinstrs := prompts.BuildCollectorPlanningInstructions()\n119\t\t\tExpect(instrs[0].Name).To(Equal(\"collector-planning\"))\n120\t\t\tExpect(instrs[0].Content).NotTo(BeEmpty())\n121\t\t})\n122\t\n123\t\tIt(\"second instruction is output-format\", func() {\n124\t\t\tinstrs := prompts.BuildCollectorPlanningInstructions()\n125\t\t\tExpect(instrs[1].Name).To(Equal(\"output-format\"))\n126\t\t\tExpect(instrs[1].Content).NotTo(BeEmpty())\n127\t\t})\n128\t\n129\t\tIt(\"collector prompt contains the sentry-create-tasks.sh invocation\", func() {\n130\t\t\tinstrs := prompts.BuildCollectorPlanningInstructions()\n131\t\t\tExpect(instrs[0].Conte