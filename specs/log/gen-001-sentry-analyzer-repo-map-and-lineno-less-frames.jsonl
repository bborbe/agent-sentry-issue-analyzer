{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-af617d3e9db94c63","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage prompts_test\n6\t\n7\timport (\n8\t\t. \"github.com/onsi/ginkgo/v2\"\n9\t\t. \"github.com/onsi/gomega\"\n10\t\n11\t\t\"github.com/bborbe/agent-sentry-issue-analyzer/pkg/prompts\"\n12\t)\n13\t\n14\tvar _ = Describe(\"BuildPlanningInstructions (triage)\", func() {\n15\t\tIt(\"returns exactly 2 instructions\", func() {\n16\t\t\tinstrs := prompts.BuildPlanningInstructions()\n17\t\t\tExpect(instrs).To(HaveLen(2))\n18\t\t})\n19\t\n20\t\tIt(\"first instruction is planning\", func() {\n21\t\t\tinstrs := prompts.BuildPlanningInstructions()\n22\t\t\tExpect(instrs[0].Name).To(Equal(\"planning\"))\n23\t\t\tExpect(instrs[0].Content).NotTo(BeEmpty())\n24\t\t})\n25\t\n26\t\tIt(\"second instruction is output-format\", func() {\n27\t\t\tinstrs := prompts.BuildPlanningInstructions()\n28\t\t\tExpect(instrs[1].Name).To(Equal(\"output-format\"))\n29\t\t\tExpect(instrs[1].Content).NotTo(BeEmpty())\n30\t\t})\n31\t\n32\t\tIt(\"planning prompt contains the token-REST live-state script invocation\", func() {\n33\t\t\tinstrs := prompts.BuildPlanningInstructions()\n34\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/sentry-read.sh\"))\n35\t\t})\n36\t\n37\t\tIt(\"planning prompt contains the read-only repo clone invocation\", func() {\n38\t\t\tinstrs := prompts.BuildPlanningInstructions()\n39\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/repo-clone.sh clone\"))\n40\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"scripts/repo-clone.sh log\"))\n41\t\t})\n42\t\n43\t\tIt(\"planning prompt contains the ## Analysis section heading\", func() {\n44\t\t\tinstrs := prompts.BuildPlanningInstructions()\n45\t\t\tExpect(instrs[0].Content).To(ContainSubstring(\"#