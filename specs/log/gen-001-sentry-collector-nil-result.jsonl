{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8a57d0955383e6a3","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\t// Package factory wires concrete dependencies for the agent-sentry-issue-analyzer binary.\n6\t//\n7\t// All factory functions follow the Create* prefix convention and contain\n8\t// zero business logic — they compose constructors with config.\n9\tpackage factory\n10\t\n11\timport (\n12\t\tagentlib \"github.com/bborbe/agent\"\n13\t\tclaudelib \"github.com/bborbe/agent/claude\"\n14\t\tdelivery \"github.com/bborbe/agent/delivery\"\n15\t\thealthcheck \"github.com/bborbe/agent/healthcheck\"\n16\t\t\"github.com/bborbe/cqrs/base\"\n17\t\tlibkafka \"github.com/bborbe/kafka\"\n18\t\tlibtime \"github.com/bborbe/time\"\n19\t\t\"github.com/bborbe/vault-cli/pkg/domain\"\n20\t\n21\t\t\"github.com/bborbe/agent-sentry-issue-analyzer/pkg/prompts\"\n22\t\t\"github.com/bborbe/agent-sentry-issue-analyzer/pkg/steps\"\n23\t)\n24\t\n25\tconst serviceName = \"agent-sentry-issue-analyzer\"\n26\t\n27\t// taskTypeSentryIssueAnalyzer is the agent-lib TaskType literal for the\n28\t// triage agent's domain task. No constant exists in agent-lib for this value,\n29\t// so we cast it locally (mirrors github-update-go-agent). Keep the literal\n30\t// exactly \"sentry-issue-analyzer\" — the collector emits it verbatim in task\n31\t// frontmatter and the Config CR taskTypes list must match.\n32\tvar taskTypeSentryIssueAnalyzer = agentlib.TaskType(\"sentry-issue-analyzer\")\n33\t\n34\t// taskTypeSentryDeepAnalyzer is the agent-lib TaskType literal for the deep\n35\t// analyzer's domain task. The triage execution phase reassigns a task to this\n36\t// type (assignee + task_type + phase: planning) on a `real bug` verdict, and\n37\t// the executor routes it to the sentry-deep-analyzer Config CR.\n38\tvar taskTypeSentryDeepAnalyzer = agentlib.TaskType(\"sentry-deep-analyzer\")\n39\t\n40\t// taskTypeSentryCollector is the agent-lib TaskType literal for the collector\n41\t// step's domain task. The daily recurring trigger creates one task of this\n42\t// type; the agent fetches the day's active unresolved Sentry alerts and\n43\t// publishes one per-alert task per (short-id, date) for the triage agent.\n44\t// Keep the literal exactly \"sentry-collector\" — the Config CR taskTypes list\n45\t// must match.\n46\tvar taskTypeSentryCollector = agentlib.TaskType(\"sentry-collector\")\n47\t\n48\t// CreateClaudeRunner constructs a ClaudeRunner pre-configured with tools,\n49\t// model, working directory, and CLI environment.\n50\tfunc CreateClaudeRunner(\n51\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n52\t\tagentDir claudelib.AgentDir,\n53\t\tallowedTools claudelib.AllowedTools,\n54\t\tmodel claudelib.ClaudeModel,\n55\t\tenv map[string]string,\n56\t) claudelib.ClaudeRunner {\n57\t\treturn claudelib.NewClaudeRunner(claudelib.ClaudeRunnerConfig{\n58\t\t\tClaudeConfigDir:  claudeConfigDir,\n59\t\t\tAllowedTools:     allowedTools,\n60\t\t\tModel:            model,\n61\t\t\tWorkingDirectory: agentDir,\n62\t\t\tEnv:              env,\n63\t\t})\n64\t}\n65\t\n66\t// CreateKafkaResultDeliverer creates a ResultDeliverer that publishes task\n67\t// updates to Kafka via CQRS commands. Uses the passthrough content generator\n68\t// — the agent framework's StepRunner already produces the full marshaled\n69\t// task in result.Output; the deliverer publishes it as-is and overrides\n70\t// status/phase frontmatter based on the result Status.\n71\tfunc CreateKafkaResultDeliverer(\n72\t\tsyncProducer libkafka.SyncProducer,\n73\t\ttopicPrefix base.TopicPrefix,\n74\t\ttaskID agentlib.TaskIdentifier,\n75\t\toriginalContent string,\n76\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n77\t) agentlib.ResultDeliverer {\n78\t\treturn delivery.NewKafkaResultDeliverer(\n79\t\t\tsyncProducer,\n80\t\t\ttopicPrefix,\n81\t\t\ttaskID,\n82\t\t\toriginalContent,\n83\t\t\tdelivery.NewPassthroughContentGenerator(),\n84\t\t\tcurrentDateTime,\n85\t\t)\n86\t}\n87\t\n88\t// CreateFileResultDeliverer creates a ResultDeliverer that writes the agent's\n89\t// output back to a markdown file (local CLI mode). Uses the passthrough\n90\t// content generator (same rationale as Kafka).\n91\tfunc CreateFileResultDeliverer(filePath string) agentlib.ResultDeliverer {\n92\t\treturn delivery.NewFileResultDeliverer(\n93\t\t\tdelivery.NewPassthroughContentGenerator(),\n94\t\t\tfilePath,\n95\t\t)\n96\t}\n97\t\n98\t// CreateAgent assembles the 2-phase Sentry analyzer agent:\n99\t//\n100\t//   - planning  → claude.NewAgentStep (planning prompt + MCP tools): fetch\n101\t//     LIVE state for the single alert, read implicated source (read-only),\n102\t//     write ## Analysis\n103\t//   - execution → claude.NewAgentStep (execution prompt): apply the 6-verdict\n104\t//     rubric + noise disqualifiers, write ## Verdict back to the task body\n105\t//\n106\t// No ai_review phase — write-verification is part of execution (two-active-phase\n107\t// pattern, per the spec). The collector creates one task per new Sentry alert;\n108\t// this agent processes exactly one task per run.\n109\tfunc CreateAgent(\n110\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n111\t\tagentDir claudelib.AgentDir,\n112\t\tallowedTools claudelib.AllowedTools,\n113\t\tmodel claudelib.ClaudeModel,\n114\t\tclaudeEnv map[string]string,\n115\t\tenvContext map[string]string,\n116\t) *agentlib.Agent {\n117\t\treturn CreateAgentFromRunner(\n118\t\t\tCreateClaudeRunner(claudeConfigDir, agentDir, allowedTools, model, claudeEnv),\n119\t\t\tenvContext,\n120\t\t)\n121\t}\n122\t\n123\t// CreateAgentFromRunner builds the triage agent given a pre-constructed\n124\t// ClaudeRunner. Used by CreateAgentProvider to share one runner across the\n125\t// domain agent and the healthcheck-Claude liveness agent.\n126\t//\n127\t// The triage execution step is wrapped in the real-bug reassign trigger: on a\n128\t// `verdict: real bug` it reassigns the SAME task to the deep analyzer\n129\t// (sentry-deep-analyzer) instead of closing it.\n130\tfunc CreateAgentFromRunner(\n131\t\trunner claudelib.ClaudeRunner,\n132\t\tenvContext map[string]string,\n133\t) *agentlib.Agent {\n134\t\tplanning := steps.NewPlanningStep(runner, prompts.BuildPlanningInstructions(), envContext)\n135\t\texecution := steps.NewReassignExecutionStep(\n136\t\t\tsteps.NewExecutionStep(runner, prompts.BuildExecutionInstructions(), envContext),\n137\t\t\tstring(taskTypeSentryDeepAnalyzer),\n138\t\t\tstring(taskTypeSentryDeepAnalyzer),\n139\t\t)\n140\t\treturn agentlib.NewAgent(\n141\t\t\tagentlib.NewPhase(\"planning\", planning),\n142\t\t\tagentlib.NewPhase(domain.TaskPhaseExecution, execution),\n143\t\t)\n144\t}\n145\t\n146\t// CreateDeepAgentFromRunner builds the deep analyzer agent given a\n147\t// pre-constructed ClaudeRunner. The deep agent is a separate task type\n148\t// (sentry-deep-analyzer) with its own octopus verdict schema and deep\n149\t// planning/execution prompts — it runs on ONE task flagged `real bug` by the\n150\t// triage agent, never batch.\n151\tfunc CreateDeepAgentFromRunner(\n152\t\trunner claudelib.ClaudeRunner,\n153\t\tenvContext map[string]string,\n154\t) *agentlib.Agent {\n155\t\tplanning := steps.NewDeepPlanningStep(\n156\t\t\trunner,\n157\t\t\tprompts.BuildDeepPlanningInstructions(),\n158\t\t\tenvContext,\n159\t\t)\n160\t\texecution := steps.NewDeepExecutionStep(\n161\t\t\trunner,\n162\t\t\tprompts.BuildDeepExecutionInstructions(),\n163\t\t\tenvContext,\n164\t\t)\n165\t\treturn agentlib.NewAgent(\n166\t\t\tagentlib.NewPhase(\"planning\", planning),\n167\t\t\tagentlib.NewPhase(domain.TaskPhaseExecution, execution),\n168\t\t)\n169\t}\n170\t\n171\t// CreateCollectorAgentFromRunner builds the collector agent given a\n172\t// pre-constructed ClaudeRunner. The collector has a single planning phase — it\n173\t// fetches the day's active unresolved Sentry alerts and publishes one\n174\t// per-alert task per (short-id, date) so the triage agent processes each. It\n175\t// replaces the retired standalone sentry-watcher service.\n176\tfunc CreateCollectorAgentFromRunner(\n177\t\trunner claudelib.ClaudeRunner,\n178\t\tenvContext map[string]string,\n179\t) *agentlib.Agent {\n180\t\tplanning := steps.NewCollectorPlanningStep(\n181\t\t\trunner,\n182\t\t\tprompts.BuildCollectorPlanningInstructions(),\n183\t\t\tenvContext,\n184\t\t)\n185\t\treturn agentlib.NewAgent(\n186\t\t\tagentlib.NewPhase(\"planning\", planning),\n187\t\t)\n188\t}\n189\t\n190\t// CreateAgentProvider wires the per-task-type dispatch table for agent-sentry-issue-analyzer.\n191\t// Returns lib.AgentProvider — main.go calls Get(ctx, taskType) to select the\n192\t// appropriate *Agent. Pure plumbing; no conditional, no error.\n193\t//\n194\t// taskTypeSentryIssueAnalyzer and TaskTypeLLM (legacy alias) both route to the\n195\t// triage agent. taskTypeSentryDeepAnalyzer routes to the deep analyzer (its\n196\t// own prompts + octopus verdict). taskTypeSentryCollector routes to the\n197\t// collector agent (single planning phase, fetches the day's alerts + publishes\n198\t// per-alert tasks). TaskTypeHealthcheck and TaskTypeOAuthProbe (transition\n199\t// alias) both route to the shared healthcheck-Claude liveness agent, reusing\n200\t// the same ClaudeRunner.\n201\tfunc CreateAgentProvider(\n202\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n203\t\tagentDir claudelib.AgentDir,\n204\t\tallowedTools claudelib.AllowedTools,\n205\t\tmodel claudelib.ClaudeModel,\n206\t\tclaudeEnv map[string]string,\n207\t\tenvContext map[string]string,\n208\t) agentlib.AgentProvider {\n209\t\trunner := CreateClaudeRunner(claudeConfigDir, agentDir, allowedTools, model, claudeEnv)\n210\t\tdomainAgent := CreateAgentFromRunner(runner, envContext)\n211\t\tdeepAgent := CreateDeepAgentFromRunner(runner, envContext)\n212\t\tcollectorAgent := CreateCollectorAgentFromRunner(runner, envContext)\n213\t\tlivenessAgent := healthcheck.NewAgent(healthcheck.NewClaudeStep(runner))\n214\t\treturn agentlib.NewAgentProvider(serviceName, map[agentlib.TaskType]*agentlib.Agent{\n215\t\t\ttaskTypeSentryIssueAnalyzer:  domainAgent,\n216\t\t\ttaskTypeSentryDeepAnalyzer:   deepAgent,\n217\t\t\ttaskTypeSentryCollector:      collectorAgent,\n218\t\t\tagentlib.TaskTypeLLM:         domainAgent,\n219\t\t\tagentlib.TaskTypeHealthcheck: livenessAgent,\n220\t\t\tagentlib.TaskTypeOAuthProbe:  livenessAgent,\n221\t\t})\n222\t}\n223\t"}]},"parent_tool_use_id":"chatcmpl-tool-a9ec0f1c05300d88","session_id":"8524de8b-d7ea-43c2-94e8-affce53f1549","uuid":"703c8cf4-973a-40e6-ba8d-8035bbd3fe68","timestamp":"2026-09-03T19:30:27.127Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from approved spec"}
