{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8df4fb5eef1ba8d0","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage claude\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"encoding/json\"\n10\t\t\"fmt\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/bborbe/errors\"\n14\t\t\"github.com/golang/glog\"\n15\t\n16\t\tagentlib \"github.com/bborbe/agent\"\n17\t)\n18\t\n19\t// AgentStepConfig bundles everything an agent Step needs at construction time.\n20\t//\n21\t// The Runner is pre-configured with AllowedTools + Model via ClaudeRunnerConfig\n22\t// at construction; per-step Instructions + EnvContext are supplied here so a\n23\t// single Runner can serve multiple steps with different prompts.\n24\ttype AgentStepConfig struct {\n25\t\t// Name is the step name for logs.\n26\t\tName string\n27\t\n28\t\t// Runner is the Claude CLI invocation backend (pre-configured with\n29\t\t// AllowedTools, Model, ClaudeConfigDir via ClaudeRunnerConfig).\n30\t\tRunner ClaudeRunner\n31\t\n32\t\t// Instructions is the system prompt for this step.\n33\t\tInstructions Instructions\n34\t\n35\t\t// EnvContext is forwarded to the Claude CLI tool-invocation environment.\n36\t\tEnvContext map[string]string\n37\t\n38\t\t// OutputSection is the body section heading for the LLM's output\n39\t\t// (e.g. \"## Analysis\", \"## Review\").\n40\t\tOutputSection string\n41\t\n42\t\t// NextPhase is the phase to advance to on success. Empty means\n43\t\t// in-place save (multi-step phase intermediate).\n44\t\tNextPhase string\n45\t}\n46\t\n47\t// NewAgentStep wraps a single Claude invocation as an agentlib.Step.\n48\t//\n49\t// Used by AI-heavy agents (trade-analysis, pr-reviewer style). The LLM\n50\t// reads the marshaled task content (frontmatter + body) and writes its\n51\t// output verbatim under the configured section heading.\n52\t//\n53\t// For boundary parsing (markdown → typed Go struct), use\n54\t// agentlib.NewParseStep with an AIParser implementation instead.\n55\tfunc NewAgentStep(cfg AgentStepConfig) agentlib.Step {\n56\t\treturn &agentStep{cfg: cfg}\n57\t}\n58\t\n59\ttype agentStep struct {\n60\t\tcfg AgentStepConfig\n61\t}\n62\t\n63\t// failureSectionHeading is the repo-wide failure-marker heading written by\n64\t// delivery/content-generator.go (and agent-task-executor's result publisher)\n65\t// on AgentStatusFailed / AgentStatusNeedsInput. Its presence means the prior\n66\t// run failed, so ShouldRun forces a re-run instead of treating the output\n67\t// section as completed work (spec 051).\n68\tconst failureSectionHeading = \"## Failure\"\n69\t\n70\t// Name implements agentlib.Step.\n71\tfunc (s *agentStep) Name() string { return s.cfg.Name }\n72\t\n73\t// ShouldRun returns false only when the output section exists and represents a\n74\t// genuine success: a body that is not a needs_input/failed AgentResult, with no\n75\t// ## Failure section present.\n76\t//\n77\t// Single-step idempotency check: if the LLM already wrote its section in a\n78\t// prior Job that crashed before phase advance, skip the re-invocation.\n79\t// (For multi-step phases, decompose the work — don't rely on a single\n80\t// AgentStep to be partially-resumable.)\n81\t//\n82\t// A failure marker — a ## Failure section, or an output-section body that\n83\t// parses to a needs_input/failed AgentResult — forces a re-run: a failed run\n84\t// is not completed work, and re-dispatch must re-invoke claude (spec 051).\n85\tfunc (s *agentStep) ShouldRun(_ context.Context, md *agentlib.Markdown) (bool, error) {\n86\t\t_, exists := md.FindSection(s.cfg.OutputSection)\n87\t\tif !exists {\n88\t\t\treturn true, nil\n89\t\t}\n90\t\tif s.failureMarked(md) {\n91\t\t\treturn true, nil\n92\t\t}\n93\t\treturn false, nil\n94\t}\n95\t\n96\t// failureMarked reports whether the task carries a failure marker that must\n97\t// force a re-run despite an existing output section: a ## Failure section, or\n98\t// an output-section body that parses to a needs_input/failed AgentResult.\n99\t// Bodies that are not a failure marker (done JSON, unparseable prose, unknown\n100\t// status) are treated as a genuine success section (spec 051).\n101\tfunc (s *agentStep) failureMarked(md *agentlib.Markdown) bool {\n102\t\tif _, exists := md.FindSection(failureSectionHeading); exists {\n103\t\t\treturn true\n104\t\t}\n105\t\tsection, exists := md.FindSection(s.cfg.OutputSection)\n106\t\tif !exists {\n107\t\t\treturn false\n108\t\t}\n109\t\tresult, ok := parseAgentResultBody(section.Body)\n110\t\tif !ok {\n111\t\t\treturn false\n112\t\t}\n113\t\treturn result.Status == agentlib.AgentStatusNeedsInput ||\n114\t\t\tresult.Status == agentlib.AgentStatusFailed\n115\t}\n116\t\n117\t// parseAgentResultBody extracts the last balanced JSON object from body and\n118\t// unmarshals it as an AgentResult. ok is false when no JSON object is present\n119\t// or unmarshal fails — callers treat an unparseable body as \"not a failure\n120\t// marker\" (best-effort parsing, spec 051). Unknown status values are not a\n121\t// failure marker and fall through to the success/skip path.\n122\tfunc parseAgentResultBody(body string) (AgentResult, bool) {\n123\t\tblob, ok := extractLastJSONObject(body)\n124\t\tif !ok {\n125\t\t\treturn AgentResult{}, false\n126\t\t}\n127\t\tvar result AgentResult\n128\t\tif err := json.Unmarshal([]byte(blob), &result); err != nil {\n129\t\t\treturn AgentResult{}, false\n130\t\t}\n131\t\treturn result, true\n132\t}\n133\t\n134\t// Run marshals the task, calls Claude with the step's prompt + tools, and\n135\t// writes the LLM's output under the configured section heading. On a\n136\t// needs_input/failed runner body the step returns that status WITHOUT writing\n137\t// the output section — the deliverer writes the ## Failure marker instead, so\n138\t// the section is never left looking like completed work (spec 051).\n139\tfunc (s *agentStep) Run(ctx context.Context, md *agentlib.Markdown) (*agentlib.Result, error) {\n140\t\ttaskContent, err := md.Marshal(ctx)\n141\t\tif err != nil {\n142\t\t\treturn nil, errors.Wrapf(ctx, err, \"%s marshal task\", s.cfg.Name)\n143\t\t}\n144\t\n145\t\tprompt := BuildPrompt(s.cfg.Instructions.String(), s.cfg.EnvContext, taskContent)\n146\t\n147\t\tglog.Infof(\"%s: invoking claude runner (prompt=%d bytes)\", s.cfg.Name, len(prompt))\n148\t\trunStart := time.Now()\n149\t\tresult, runErr := s.cfg.Runner.Run(ctx, prompt)\n150\t\tif runErr != nil {\n151\t\t\tglog.Infof(\n152\t\t\t\t\"%s: claude runner failed after %s: %v\",\n153\t\t\t\ts.cfg.Name,\n154\t\t\t\ttime.Since(runStart),\n155\t\t\t\trunErr,\n156\t\t\t)\n157\t\t\treturn &agentlib.Result{\n158\t\t\t\tStatus:  agentlib.AgentStatusFailed,\n159\t\t\t\tMessage: fmt.Sprintf(\"%s claude run failed: %v\", s.cfg.Name, runErr),\n160\t\t\t}, nil\n161\t\t}\n162\t\tglog.Infof(\n163\t\t\t\"%s: claude runner returned %d bytes in %s\",\n164\t\t\ts.cfg.Name,\n165\t\t\tlen(result.Result),\n166\t\t\ttime.Since(runStart),\n167\t\t)\n168\t\n169\t\t// A needs_input/failed body is a failed run, not completed work — return\n170\t\t// that status and let the deliverer write the ## Failure marker. Never\n171\t\t// write a success-looking output section for a failed run: that section\n172\t\t// would make ShouldRun skip every subsequent re-dispatch (spec 051).\n173\t\tif parsed, ok := parseAgentResultBody(result.Result); ok &&\n174\t\t\t(parsed.Status == agentlib.AgentStatusNeedsInput ||\n175\t\t\t\tparsed.Status == agentlib.AgentStatusFailed) {\n176\t\t\tmsg := parsed.Message\n177\t\t\tif msg == \"\" {\n178\t\t\t\tmsg = fmt.Sprintf(\"%s claude run returned status %s\", s.cfg.Name, parsed.Status)\n179\t\t\t}\n180\t\t\treturn &agentlib.Result{\n181\t\t\t\tStatus:  parsed.Status,\n182\t\t\t\tMessage: msg,\n183\t\t\t}, nil\n184\t\t}\n185\t\n186\t\tmd.ReplaceSection(agentlib.Section{\n187\t\t\tHeading: s.cfg.OutputSection,\n188\t\t\tBody:    result.Result,\n189\t\t})\n190\t\n191\t\treturn &agentlib.Result{\n192\t\t\tStatus:    agentlib.AgentStatusDone,\n193\t\t\tNextPhase: s.cfg.NextPhase,\n194\t\t}, nil\n195\t}\n196\t"}]},"parent_tool_use_id":"chatcmpl-tool-a9ec0f1c05300d88","session_id":"8524de8b-d7ea-43c2-94e8-affce53f1549","uuid":"d14eaab3-e4d9-4bab-b4ea-2d31dd0ad0de","timestamp":"2026-09-03T19:30:38.299Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from approved spec"}
