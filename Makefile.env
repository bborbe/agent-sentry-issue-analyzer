include $(ROOTDIR)/common.env
# dev.env / prod.env carry per-stage runtime config for a LOCAL `make run` only.
# No build goal requires a branch: the image tag names the source, not a stage.
ifeq ($(BRANCH),prod)
include $(ROOTDIR)/prod.env
else ifeq ($(BRANCH),dev)
include $(ROOTDIR)/dev.env
endif

# upload, clean and buca stay on the local arm — they act on this machine's
# Docker daemon. This is a parse-time refusal, not a recipe-level exit, so it
# also fires under `make -n`.
ifneq ($(BUILD_TARGET),local)
ifneq ($(filter upload clean buca,$(MAKECMDGOALS)),)
$(error upload, clean and buca are local-only; unset BUILD_TARGET (got '$(BUILD_TARGET)'))
endif
endif

# The cluster arm pushes the tag the caller named. VERSION carries a
# `git describe` default in Makefile.docker, so the refusal must fire when
# $(origin VERSION) is `file` (that default) or `undefined` (nobody set it):
# a scratch build must not publish over a tag the caller did not choose.
ifneq ($(BUILD_TARGET),local)
ifneq ($(filter build,$(MAKECMDGOALS)),)
ifneq ($(filter file undefined,$(origin VERSION)),)
$(error the cluster build arm needs an explicit VERSION: make build BUILD_TARGET=$(BUILD_TARGET) REF=<sha> VERSION=<tag>)
endif
endif
endif
