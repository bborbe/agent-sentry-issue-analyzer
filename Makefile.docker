# BUILD_TARGET selects where `make build` runs. `local` (the default) uses the
# local Docker daemon; any other value names a cluster alias (sun / nukedev /
# nukeprod) and builds inside that cluster as a Job rendered from
# hack/build-job.yaml.
BUILD_TARGET ?= local

# The local arm tags $(DOCKER_REGISTRY)/$(IMAGE) — the private mirror, using the
# operator's own Docker credentials.
#
# The cluster arm pushes somewhere else on purpose. The build lane's
# buildkit-push credential authenticates against Docker Hub, which is where the
# sibling agent repos land (measured: a sibling cluster build pushed
# docker.io/bborbe/git-rest:v0.40.5, while the same arm pointed at the private
# mirror fails the push with 401 Unauthorized). The private-registry copy the
# deployment pulls is produced by nuke's MIRROR_IMAGES step, not by this build.
IMAGE ?= $(SERVICE)
CLUSTER_IMAGE ?= docker.io/bborbe/$(SERVICE)

.PHONY: build
build: $(if $(filter local,$(BUILD_TARGET)),check-go-mod)
ifeq ($(BUILD_TARGET),local)
	DOCKER_BUILDKIT=1 \
	docker build \
	--pull \
	--no-cache \
	--rm=true \
	--platform=linux/amd64 \
	--build-arg DOCKER_REGISTRY=$(DOCKER_REGISTRY) \
	--build-arg BRANCH=$(BRANCH) \
	--build-arg BUILD_GIT_VERSION=$$(git describe --tags --always --dirty) \
	--build-arg BUILD_GIT_COMMIT=$$(git rev-parse --short HEAD) \
	--build-arg BUILD_DATE=$$(date -u +%Y-%m-%dT%H:%M:%SZ) \
	-t $(DOCKER_REGISTRY)/$(IMAGE):$(BRANCH) \
	-f Dockerfile .
else
	@echo "$(CLUSTER_IMAGE):$(VERSION)"
	BUILD_TARGET='$(BUILD_TARGET)' \
	REPO_URL='https://github.com/bborbe/agent-sentry-issue-analyzer.git' \
	REF='$(REF)' \
	TAG='$(VERSION)' \
	IMAGE='$(CLUSTER_IMAGE)' \
	PUSH='true' \
	PUSH_SECRET='buildkit-push' \
	hack/build-cluster.sh
endif

.PHONY: check-go-mod
check-go-mod:
	@if [ -f "go.mod" ]; then \
		echo "go.mod found, running go mod vendor..."; \
		go mod vendor; \
	else \
		echo "go.mod not found, skipping go mod vendor."; \
	fi

.PHONY: upload
upload:
	docker push $(DOCKER_REGISTRY)/$(IMAGE):$(BRANCH)

.PHONY: clean
clean:
	docker rmi $(DOCKER_REGISTRY)/$(IMAGE):$(BRANCH) || true
	docker image prune -f || true
	docker builder prune --all -f || true
	rm -rf vendor

.PHONY: buca
buca: build upload clean
