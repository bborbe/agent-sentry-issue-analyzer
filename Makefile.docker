# BUILD_TARGET selects where `make build` runs. `local` (the default) uses the
# local Docker daemon; any other value names a cluster alias (sun / nukedev /
# nukeprod) and builds inside that cluster as a Job rendered from
# hack/build-job.yaml.
BUILD_TARGET ?= local

# Both arms publish ONE reference: Docker Hub. The cluster lane's buildkit-push
# credential authenticates against Docker Hub (measured: a sibling cluster build
# pushed docker.io/bborbe/git-rest:v0.40.5, while the same arm pointed at the
# private mirror fails the push with 401 Unauthorized), and the local arm pushes
# there with the operator's own credentials. The private-registry copy the fleet
# pulls is produced by nuke's MIRROR_IMAGES step, never by this build.
#
# DOCKER_REGISTRY is the BASE-IMAGE source and PUSH_REGISTRY the push target —
# two knobs, deliberately separate, so a repo whose base images resolve from the
# private mirror still cannot push there.
DOCKER_REGISTRY ?= docker.io
PUSH_REGISTRY ?= docker.io
IMAGE ?= bborbe/$(SERVICE)

# The tag both arms publish. A release build passes VERSION=vX.Y.Z explicitly;
# with no VERSION the `git describe` default names the commit — `vX.Y.Z-<n>-g<sha>`
# once HEAD has moved past a release, and exactly `vX.Y.Z` only when HEAD *is*
# that release commit. There is no branch or stage input: the tag names the
# source, not an environment. Rebuilding at a released tag re-pushes it with a
# new digest, so a release is built once.
VERSION ?= $(shell git describe --tags --always)

.PHONY: build
build: $(if $(filter local,$(BUILD_TARGET)),check-go-mod)
ifeq ($(BUILD_TARGET),local)
	DOCKER_BUILDKIT=1 \
	docker build \
	--pull \
	--no-cache \
	--rm=true \
	--platform=linux/amd64 \
	--build-arg DOCKER_REGISTRY=$(DOCKER_REGISTRY) \
	--build-arg BUILD_GIT_VERSION=$$(git describe --tags --always --dirty) \
	--build-arg BUILD_GIT_COMMIT=$$(git rev-parse --short HEAD) \
	--build-arg BUILD_DATE=$$(date -u +%Y-%m-%dT%H:%M:%SZ) \
	-t $(PUSH_REGISTRY)/$(IMAGE):$(VERSION) \
	-f Dockerfile .
else
	@echo "$(PUSH_REGISTRY)/$(IMAGE):$(VERSION)"
	BUILD_TARGET='$(BUILD_TARGET)' \
	REPO_URL='https://github.com/bborbe/agent-sentry-issue-analyzer.git' \
	REF='$(REF)' \
	TAG='$(VERSION)' \
	IMAGE='$(PUSH_REGISTRY)/$(IMAGE)' \
	DOCKER_REGISTRY='$(DOCKER_REGISTRY)' \
	PUSH='true' \
	PUSH_SECRET='buildkit-push' \
	hack/build-cluster.sh
endif

.PHONY: check-go-mod
check-go-mod:
	@if [ -f "go.mod" ]; then \
		echo "go.mod found, running go mod vendor..."; \
		go mod vendor; \
	else \
		echo "go.mod not found, skipping go mod vendor."; \
	fi

.PHONY: upload
upload:
	docker push $(PUSH_REGISTRY)/$(IMAGE):$(VERSION)

.PHONY: clean
clean:
	docker rmi $(PUSH_REGISTRY)/$(IMAGE):$(VERSION) || true
	docker image prune -f || true
	docker builder prune --all -f || true
	rm -rf vendor

.PHONY: buca
buca: build upload clean
